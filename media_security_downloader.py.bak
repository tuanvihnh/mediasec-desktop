# ═══════════════════════════════════════════════════════════════════════════════
# UTILITY FUNCTIONS: DURATION, BYTES, THUMBNAIL
# ═══════════════════════════════════════════════════════════════════════════════

def format_duration(seconds: Optional[float | int]) -> str:
    """Định dạng số giây thành chuỗi thời lượng trực quan mm:ss hoặc hh:mm:ss."""
    if not seconds or seconds <= 0:
        return "Không rõ"
    sec = int(seconds)
    m, s = divmod(sec, 60)
    h, m = divmod(m, 60)
    if h > 0:
        return f"{h:02d}:{m:02d}:{s:02d}"
    return f"{m:02d}:{s:02d}"


def parse_time_to_seconds(time_str: Optional[str]) -> Optional[float]:
    """
    Chuyển đổi chuỗi thời gian người dùng nhập thành số giây (float).
    Hỗ trợ các định dạng:
    - "SS" hoặc "SS.s" (ví dụ: "45", "90.5")
    - "MM:SS" (ví dụ: "01:30" -> 90.0)
    - "HH:MM:SS" (ví dụ: "01:15:30" -> 4530.0)
    - "HH:MM:SS.mmm" (ví dụ: "00:01:30.500" -> 90.5)
    Trả về số giây hoặc None nếu không hợp lệ hoặc để trống.
    """
    if not time_str or not isinstance(time_str, str):
        return None
    s = time_str.strip().replace(",", ".")
    if not s:
        return None
    parts = s.split(":")
    try:
        if len(parts) == 1:
            return max(0.0, float(parts[0]))
        elif len(parts) == 2:
            return max(0.0, float(parts[0]) * 60 + float(parts[1]))
        elif len(parts) == 3:
            return max(0.0, float(parts[0]) * 3600 + float(parts[1]) * 60 + float(parts[2]))
    except ValueError:
        return None
    return None


def format_bytes(bytes_count: Optional[float | int]) -> str:
    """Định dạng dung lượng bytes sang KB, MB, GB."""
    if not bytes_count or bytes_count <= 0:
        return ""
    b = float(bytes_count)
    for unit in ["B", "KB", "MB", "GB"]:
        if b < 1024.0:
            return f"{b:.1f} {unit}"
        b /= 1024.0
    return f"{b:.1f} TB"


def clean_ansi_escape(text: str) -> str:
    """Loại bỏ các ký tự mã màu ANSI escape sequences (như \x1b[0;31m)."""
    if not text or not isinstance(text, str):
        return ""
    # Dùng regex chuẩn theo yêu cầu: re.sub(r'\x1b\[[0-9;]*m', '', text)
    cleaned = re.sub(r"\x1b\[[0-9;]*m", "", text)
    # Loại bỏ thêm các mã escape ANSI mở rộng nếu có
    cleaned = re.sub(r"\x1b\[[0-9;]*[a-zA-Z]", "", cleaned)
    return cleaned.strip()


def create_placeholder_thumbnail(
    size: tuple[int, int] = (160, 90),
    text: str = "No Thumbnail",
    bg_color: str = "#242424",
    fg_color: str = "#888888",
) -> Optional[Image.Image]:
    """Tạo ảnh placeholder cố định 160x90 px khi không có thumbnail hoặc tải lỗi."""
    if not HAS_PIL:
        return None
    try:
        img = Image.new("RGB", size, color=bg_color)
        draw = ImageDraw.Draw(img)
        # Vẽ viền khung
        draw.rectangle([0, 0, size[0] - 1, size[1] - 1], outline="#3e3e3e", width=1)
        font = ImageFont.load_default()
        bbox = draw.textbbox((0, 0), text, font=font)
        tw = bbox[2] - bbox[0]
        th = bbox[3] - bbox[1]
        x = (size[0] - tw) // 2
        y = (size[1] - th) // 2
        draw.text((x, y), text, fill=fg_color, font=font)
        return img
    except Exception:
        return None


def load_thumbnail_pil(
    thumbnail_url: str,
    size: tuple[int, int] = (160, 90),
) -> Optional[Image.Image]:
    """
    Tải và resize ảnh thumbnail bằng PIL/Pillow thành đối tượng Image.Image
    với kích thước cố định khoảng 160x90 px (canh giữa trên nền tối).
    """
    if not HAS_PIL or not thumbnail_url:
        return None
    try:
        req = urllib.request.Request(
            thumbnail_url,
            headers={
                "User-Agent": (
                    "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
                    "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
                )
            },
        )
        with urllib.request.urlopen(req, timeout=6) as resp:
            data = resp.read()

        img = Image.open(io.BytesIO(data))
        if img.mode != "RGB":
            img = img.convert("RGB")

        # Giữ tỷ lệ khung hình và fit vào khung size
        resample_filter = getattr(Image, "Resampling", Image).LANCZOS
        img.thumbnail(size, resample_filter)

        # Tạo nền tối để canh giữa ảnh (letterbox 160x90)
        bg = Image.new("RGB", size, (25, 25, 25))
        offset = ((size[0] - img.width) // 2, (size[1] - img.height) // 2)
        bg.paste(img, offset)
        return bg
    except Exception:
        return None


def load_thumbnail_png_bytes(thumbnail_url: str, size: tuple[int, int] = (160, 90)) -> Optional[bytes]:
    """Tương thích ngược: tải và trả về PNG bytes."""
    img = load_thumbnail_pil(thumbnail_url, size)
    if not img:
        return None
    try:
        buf = io.BytesIO()
        img.save(buf, format="PNG")
        return buf.getvalue()
    except Exception:
        return None


def upgrade_twitter_image_url(url: str, prefer_png: bool = True, probe_head: bool = True) -> str:
    """
    Bộ chuẩn hóa URL lấy ảnh gốc tối đa (Master Resolution Extractor):
    - Đối với URL ảnh từ Twitter/X (pbs.twimg.com/media/...): Tự động dùng regex tách các tham số query
      và thay thế bằng format=png (hoặc định dạng gốc) kèm name=orig để tải chất lượng cao nhất của tác giả,
      loại bỏ phiên bản nén của Twitter (small, 900x900, large...).
    - Giữ nguyên metadata và bảo toàn ICC Color Profile khi lưu file bằng Pillow.
    """
    if not url or "pbs.twimg.com/media/" not in url:
        return url

    m = re.search(r"https?://pbs\.twimg\.com/media/([a-zA-Z0-9_-]+)(?:\.([a-zA-Z0-9]+))?", url)
    if not m:
        return url

    media_id = m.group(1)
    ext_in_path = m.group(2)

    parsed = urlparse(url)
    q_params = parse_qs(parsed.query)
    current_fmt = (q_params.get("format", [None])[0] or ext_in_path or "jpg").lower()
    if ":" in current_fmt:
        current_fmt = current_fmt.split(":")[0]

    # Danh sách candidate format để lấy ảnh gốc tối đa
    if current_fmt == "png":
        candidates = ["png", "jpg"]
    else:
        # Nếu url ban đầu là jpg, tác giả có thể đã upload PNG nhưng Twitter web hiển thị jpg
        candidates = ["png", current_fmt] if prefer_png else [current_fmt, "png"]

    if probe_head:
        headers = {
            "User-Agent": (
                "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                "AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
            ),
            "Referer": "https://twitter.com/",
        }
        for c_fmt in candidates:
            cand_url = f"https://pbs.twimg.com/media/{media_id}?format={c_fmt}&name=orig"
            try:
                req = urllib.request.Request(cand_url, headers=headers, method="HEAD")
                with urllib.request.urlopen(req, timeout=3) as resp:
                    if resp.status == 200:
                        return cand_url
            except Exception:
                continue

    # Fallback nếu không probe được (offline hoặc timeout)
    target_fmt = candidates[0] if prefer_png else current_fmt
    return f"https://pbs.twimg.com/media/{media_id}?format={target_fmt}&name=orig"


def extract_twitter_fallback(url: str) -> Optional[dict]:
    """
    Cơ chế dự phòng trích xuất media Twitter/X qua vxtwitter / fxtwitter API
    khi yt-dlp gặp lỗi 'No video could be found' do giới hạn guest token với bài NSFW/nhạy cảm
    hoặc khi bài đăng là bài chứa hình ảnh tĩnh / album ảnh.
    """
    m = RE_TWITTER.match(url)
    if not m:
        return None
    tweet_id = m.group(1)

    api_endpoints = [
        f"https://api.vxtwitter.com/Twitter/status/{tweet_id}",
        f"https://api.fxtwitter.com/Twitter/status/{tweet_id}",
    ]
    # Dùng User-Agent TelegramBot để dịch vụ trả về JSON embed
    headers = {"User-Agent": "TelegramBot (like TwitterBot)"}

    for api_url in api_endpoints:
        try:
            req = urllib.request.Request(api_url, headers=headers)
            with urllib.request.urlopen(req, timeout=8) as resp:
                if resp.status == 200:
                    raw_data = resp.read()
                    data = json.loads(raw_data.decode("utf-8", errors="ignore"))
                    media_list = data.get("media_extended") or []
                    video_media = [
                        item for item in media_list if item.get("type") in ("video", "gif")
                    ]
                    if not video_media and data.get("mediaURLs"):
                        mp4_urls = [u for u in data["mediaURLs"] if ".mp4" in u.lower()]
                        if mp4_urls:
                            video_media = [{"url": mp4_urls[0], "type": "video"}]

                    if video_media:
                        vm = video_media[0]
                        direct_url = vm.get("url")
                        if not direct_url:
                            continue
                        thumb = vm.get("thumbnail_url") or data.get("user_profile_image_url")
                        dur_sec = (vm.get("duration_millis") or 0) / 1000.0 if vm.get("duration_millis") else None
                        w = vm.get("size", {}).get("width")
                        h = vm.get("size", {}).get("height")

                        formats = [{
                            "url": direct_url,
                            "ext": "mp4",
                            "width": w,
                            "height": h,
                            "vcodec": "h264",
                            "acodec": "aac",
                            "format_id": "direct_http",
                        }]

                        uploader = (
                            data.get("user_name")
                            or data.get("user_screen_name")
                            or "Twitter"
                        )
                        return {
                            "id": tweet_id,
                            "title": data.get("text") or f"Tweet {tweet_id}",
                            "uploader": uploader,
                            "channel": data.get("user_screen_name"),
                            "duration": dur_sec,
                            "thumbnail": thumb,
                            "formats": formats,
                            "url": direct_url,
                            "extractor": "twitter",
                            "subtitles": {},
                            "automatic_captions": {},
                            "_is_fallback": True,
                        }

                    # Xử lý Photo Tweet (bài đăng chứa ảnh tĩnh của tác giả)
                    image_media = [
                        item for item in media_list if item.get("type") == "image"
                    ]
                    if not image_media and data.get("mediaURLs"):
                        image_media = [{"url": u, "type": "image"} for u in data["mediaURLs"] if not (".mp4" in u.lower())]

                    if image_media:
                        all_img_urls: list[str] = []
                        for im in image_media:
                            raw_u = im.get("url")
                            if raw_u:
                                upgraded = upgrade_twitter_image_url(raw_u, prefer_png=True)
                                if upgraded not in all_img_urls:
                                    all_img_urls.append(upgraded)

                        if all_img_urls:
                            best_img_url = all_img_urls[0]
                            uploader = (
                                data.get("user_name")
                                or data.get("user_screen_name")
                                or "Twitter"
                            )
                            img_ext = "png" if "format=png" in best_img_url else "jpg"
                            is_album = len(all_img_urls) > 1
                            return {
                                "id": tweet_id,
                                "title": data.get("text") or f"Twitter Photo {tweet_id}",
                                "uploader": uploader,
                                "channel": data.get("user_screen_name"),
                                "media_type": "album" if is_album else "image",
                                "media_url": best_img_url,
                                "images": all_img_urls,
                                "thumbnail": best_img_url,
                                "ext": img_ext,
                                "extractor": "twitter",
                                "_is_fallback": True,
                            }
        except Exception:
            continue
    return None


# ═══════════════════════════════════════════════════════════════════════════════
# SUBTITLE ENGINE & TRANSLATION (VIETNAMESE / ENGLISH)
# ═══════════════════════════════════════════════════════════════════════════════

def parse_sub_content(content: str) -> list[tuple[str, str]]:
    """
    Phân tích nội dung file phụ đề (SRT hoặc WebVTT) thành danh sách các block:
    [(khoảng_thời_gian_srt, nội_dung_thoại)].
    Loại bỏ các thẻ HTML / VTT định dạng.
    """
    content = content.replace("\r\n", "\n").replace("\r", "\n")
    lines = content.split("\n")
    blocks: list[tuple[str, str]] = []
    current_time: Optional[str] = None
    current_text: list[str] = []

    time_pattern = re.compile(
        r"(\d{1,2}:(?:\d{2}:)?\d{2}[.,]\d{3})\s*-->\s*(\d{1,2}:(?:\d{2}:)?\d{2}[.,]\d{3})"
    )

    for line in lines:
        line_clean = line.strip()
        m = time_pattern.search(line_clean)
        if m:
            if current_time and current_text:
                blocks.append((current_time, " ".join(current_text).strip()))
            start_t, end_t = m.group(1), m.group(2)
            if start_t.count(":") == 1:
                start_t = "00:" + start_t
            if end_t.count(":") == 1:
                end_t = "00:" + end_t
            current_time = f"{start_t.replace('.', ',')} --> {end_t.replace('.', ',')}"
            current_text = []
        elif current_time is not None:
            if not line_clean:
                if current_time and current_text:
                    blocks.append((current_time, " ".join(current_text).strip()))
                    current_time = None
                    current_text = []
            elif not (line_clean.isdigit() and len(current_text) == 0):
                clean_text = re.sub(r"<[^>]+>", "", line_clean).strip()
                if clean_text:
                    current_text.append(clean_text)

    if current_time and current_text:
        blocks.append((current_time, " ".join(current_text).strip()))

    return blocks


def translate_texts_batch(texts: list[str], target_lang: str = "vi") -> list[str]:
    """
    Dịch hàng loạt các đoạn phụ đề sang ngôn ngữ đích (vi hoặc en)
    sử dụng endpoint dịch nhanh an toàn, tự động gom nhóm để tăng tốc.
    """
    if not texts:
        return []

    sep = "\n<<<SEG>>>\n"
    combined = sep.join(texts)
    try:
        url = (
            "https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl="
            + target_lang
            + "&dt=t&q="
            + urllib.parse.quote(combined)
        )
        req = urllib.request.Request(
            url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36"}
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            translated_combined = "".join([item[0] for item in data[0] if item[0]])
            parts = [p.strip() for p in translated_combined.split("<<<SEG>>>")]
            if len(parts) == len(texts):
                return parts
    except Exception:
        pass

    # Fallback từng câu nếu batch ghép chuỗi gặp lỗi
    results = []
    for t in texts:
        if not t.strip():
            results.append("")
            continue
        try:
            url = (
                "https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl="
                + target_lang
                + "&dt=t&q="
                + urllib.parse.quote(t)
            )
            req = urllib.request.Request(
                url, headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64)"}
            )
            with urllib.request.urlopen(req, timeout=5) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                results.append("".join([item[0] for item in data[0] if item[0]]).strip())
        except Exception:
            results.append(t)
    return results


def translate_subtitles_file(
    source_file: str,
    target_file: str,
    target_lang: str = "vi",
    on_progress: Optional[callable] = None,  # type: ignore[type-arg]
) -> bool:
    """
    Đọc file phụ đề gốc (SRT hoặc VTT), dịch toàn bộ nội dung thoại sang target_lang
    (tiếng Việt 'vi' hoặc tiếng Anh 'en') và ghi ra file chuẩn .srt.
    """
    try:
        with open(source_file, "r", encoding="utf-8", errors="replace") as f:
            content = f.read()

        blocks = parse_sub_content(content)
        if not blocks:
            return False

        batch_size = 25
        translated_texts: list[str] = []
        total_blocks = len(blocks)

        for i in range(0, total_blocks, batch_size):
            chunk = [b[1] for b in blocks[i : i + batch_size]]
            translated_chunk = translate_texts_batch(chunk, target_lang=target_lang)
            translated_texts.extend(translated_chunk)
            if on_progress:
                on_progress(min(100.0, (i + len(chunk)) / total_blocks * 100))

        # Ghi ra file .srt chuẩn
        with open(target_file, "w", encoding="utf-8") as f:
            for idx, (t_range, trans_txt) in enumerate(
                zip([b[0] for b in blocks], translated_texts), 1
            ):
                f.write(f"{idx}\n{t_range}\n{trans_txt}\n\n")

        return True
    except Exception:
        return False


# ═══════════════════════════════════════════════════════════════════════════════
# MANIFEST ANALYSIS – DRM & CLEARTEXT DETECTION
# ═══════════════════════════════════════════════════════════════════════════════

def _fetch_manifest(url: str, timeout: int = 15) -> Optional[str]:
    """Tải nội dung manifest (m3u8/mpd) qua HTTP GET."""
    try:
        if HAS_REQUESTS:
            resp = requests.get(url, timeout=timeout, allow_redirects=True)
            resp.raise_for_status()
            return resp.text
        else:
            req = urllib.request.Request(url, headers={"User-Agent": "AuditTool/1.0"})
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                return resp.read().decode("utf-8", errors="replace")
    except Exception:
        return None


def detect_drm_mpd(manifest_text: str) -> list[str]:
    """Phát hiện DRM trong file DASH .mpd – quét thẻ <ContentProtection>."""
    found: list[str] = []
    try:
        root = ET.fromstring(manifest_text)
    except ET.ParseError:
        return found

    for elem in root.iter():
        tag_local = elem.tag.rsplit("}", 1)[-1] if "}" in elem.tag else elem.tag
        if tag_local == "ContentProtection":
            scheme = (elem.get("schemeIdUri") or "").lower()
            for uuid, name in DRM_UUIDS.items():
                if uuid in scheme:
                    found.append(name)
                    break
            else:
                value = elem.get("value") or elem.get("schemeIdUri") or "Unknown"
                if value.lower() not in ("cenc",):
                    found.append(f"ContentProtection({value})")
    return list(dict.fromkeys(found))


def detect_drm_hls(manifest_text: str) -> list[str]:
    """Phát hiện DRM / mã hóa trong file HLS .m3u8."""
    found: list[str] = []
    for line in manifest_text.splitlines():
        line_s = line.strip()
        if line_s.startswith("#EXT-X-KEY:"):
            attrs = line_s[len("#EXT-X-KEY:") :]
            if "METHOD=SAMPLE-AES" in attrs.upper():
                found.append("HLS SAMPLE-AES (FairPlay/DRM)")
            elif "METHOD=AES-128" in attrs.upper():
                found.append("HLS AES-128 Encryption")
        if line_s.startswith("#EXT-X-SESSION-KEY:"):
            found.append("HLS Session Key (có thể DRM)")
    return list(dict.fromkeys(found))


def check_cleartext_warning(manifest_text: str, is_mpd: bool) -> bool:
    """Trả về True nếu manifest KHÔNG có bất kỳ mã hóa nào → cleartext."""
    if is_mpd:
        return len(detect_drm_mpd(manifest_text)) == 0
    else:
        for line in manifest_text.splitlines():
            ls = line.strip()
            if ls.startswith("#EXT-X-KEY:") and "METHOD=NONE" not in ls.upper():
                return False
        return True


# ═══════════════════════════════════════════════════════════════════════════════
# SPOTIFY METADATA RESOLVER (SPOTDL PATTERN)
# ═══════════════════════════════════════════════════════════════════════════════

def resolve_spotify_track(url: str) -> Optional[dict]:
    """
    Trích xuất metadata bài hát Spotify (Tên bài, Ca sĩ, Thời lượng, Thumbnail).
    Sử dụng kỹ thuật spotDL: Lấy thông tin từ Spotify Embed công khai,
    không cần tài khoản Premium, không cần API Key.
    """
    m = re.search(r"spotify\.com/(?:intl-[a-z]{2}/)?track/([a-zA-Z0-9]+)", url)
    if not m:
        return None
    track_id = m.group(1)

    embed_url = f"https://open.spotify.com/embed/track/{track_id}"
    try:
        headers = {
            "User-Agent": (
                "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
                "AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
            )
        }
        if HAS_REQUESTS:
            resp = requests.get(embed_url, timeout=10, headers=headers)
            html = resp.text
        else:
            req = urllib.request.Request(embed_url, headers=headers)
            with urllib.request.urlopen(req, timeout=10) as r:
                html = r.read().decode("utf-8", errors="ignore")

        m_data = re.search(r'<script id="__NEXT_DATA__" type="application/json">(.*?)</script>', html)
        if m_data:
            data = json.loads(m_data.group(1))
            entity = (
                data.get("props", {})
                .get("pageProps", {})
                .get("state", {})
                .get("data", {})
                .get("entity", {})
            )
            title = entity.get("name") or entity.get("title")
            artists = [a.get("name") for a in entity.get("artists", []) if a.get("name")]
            duration = (entity.get("duration") or 0) / 1000.0 if entity.get("duration") else None
            cover_art = entity.get("visualIdentity", {}).get("image", [{}])
            thumbnail = cover_art[0].get("url") if cover_art else None
            if title:
                return {
                    "id": track_id,
                    "title": title,
                    "artists": artists,
                    "duration": duration,
                    "thumbnail": thumbnail,
                }
    except Exception:
        pass

    # Fallback qua oEmbed
    try:
        oembed_url = f"https://open.spotify.com/oembed?url=https://open.spotify.com/track/{track_id}"
        if HAS_REQUESTS:
            r = requests.get(oembed_url, timeout=10, headers={"User-Agent": "Mozilla/5.0"})
            if r.status_code == 200:
                data = r.json()
                title = data.get("title")
                thumbnail = data.get("thumbnail_url")
                if title:
                    return {
                        "id": track_id,
                        "title": title,
                        "artists": [],
                        "duration": None,
                        "thumbnail": thumbnail,
                    }
        else:
            req = urllib.request.Request(oembed_url, headers={"User-Agent": "Mozilla/5.0"})
            with urllib.request.urlopen(req, timeout=10) as r:
                data = json.loads(r.read().decode("utf-8"))
                title = data.get("title")
                thumbnail = data.get("thumbnail_url")
                if title:
                    return {
                        "id": track_id,
                        "title": title,
                        "artists": [],
                        "duration": None,
                        "thumbnail": thumbnail,
                    }
    except Exception:
        pass

    return None


# ═══════════════════════════════════════════════════════════════════════════════
# DISK & PERMISSION CHECKS
# ═══════════════════════════════════════════════════════════════════════════════

def preflight_disk_check(save_dir: str) -> tuple[bool, str]:
    """Kiểm tra quyền ghi và dung lượng trống trước khi tải."""
    path = Path(save_dir)
    if not path.is_dir():
        return False, f"Thư mục không tồn tại: {save_dir}"
    if not os.access(save_dir, os.W_OK):
        return False, f"Không có quyền ghi vào: {save_dir}"

    usage = shutil.disk_usage(save_dir)
    free_mb = usage.free / (1024 * 1024)
    if usage.free < MIN_FREE_DISK_BYTES:
        return False, (
            f"Dung lượng trống không đủ: {free_mb:.0f} MB "
            f"(cần tối thiểu {MIN_FREE_DISK_BYTES // (1024*1024)} MB)"
        )
    return True, f"OK – Còn trống {free_mb:.0f} MB"


# ═══════════════════════════════════════════════════════════════════════════════
# FILE INTEGRITY VALIDATION & SECURITY HARDENING (CHỐNG MÃ ĐỘC)
# ═══════════════════════════════════════════════════════════════════════════════

def harden_file_permissions(filepath: str) -> bool:
    """
    Bảo mật Linux: Bỏ toàn bộ quyền thực thi (chmod 0644: -rw-r--r--).
    Đảm bảo file tải về không thể bị thực thi trực tiếp, chống mã độc.
    """
    try:
        os.chmod(filepath, 0o644)
        return True
    except OSError:
        return False


def compute_file_sha256(filepath: str) -> Optional[str]:
    """Tính mã băm SHA-256 để kiểm định tính toàn vẹn và đối chiếu mẫu mã độc."""
    try:
        h = hashlib.sha256()
        with open(filepath, "rb") as f:
            while chunk := f.read(65536):
                h.update(chunk)
        return h.hexdigest()
    except OSError:
        return None


def cleanup_temp_files(save_dir: str, prefix: str = "") -> int:
    """Dọn dẹp các file tạm .part, .ytdl dở dang khi bị hủy hoặc gặp lỗi."""
    cleaned = 0
    try:
        p_dir = Path(save_dir)
        if p_dir.is_dir():
            for f in p_dir.iterdir():
                if f.is_file() and (f.suffix in (".part", ".ytdl", ".temp")):
                    if not prefix or f.name.startswith(prefix):
                        try:
                            f.unlink()
                            cleaned += 1
                        except OSError:
                            pass
    except Exception:
        pass
    return cleaned


def validate_file_integrity(filepath: str) -> tuple[bool, list[str]]:
    """
    Kiểm tra tính toàn vẹn file sau khi tải về và tăng cường bảo mật.

    1. Tự động thu hồi quyền thực thi (chmod 0644)
    2. Chặn ký tự ẩn RLO (Right-to-Left Override) đánh tráo tên file
    3. Extension whitelist check
    4. Quét chữ ký nhị phân thực thi (ELF, PE exe, Shebang, Java bytecode)
    5. Double extension detection (e.g. video.mp4.exe)
    6. Magic bytes (file signature) validation
    7. File size anomaly check

    Returns: (is_safe, list_of_warnings)
    """
    warnings: list[str] = []
    p = Path(filepath)

    if not p.is_file():
        return True, []  # File không tồn tại (có thể là temp), bỏ qua

    # 1. Tự động thu hồi quyền thực thi (chống nguy cơ thực thi file)
    harden_file_permissions(filepath)

    # 2. Phát hiện ký tự RLO (Right-to-Left Override) độc hại
    if "\u202e" in p.name:
        warnings.append(
            f"🚨 NGUY HIỂM: Phát hiện ký tự RLO (Right-to-Left Override) ẩn nhằm đánh tráo đuôi file: {repr(p.name)}"
        )

    # 3. Extension whitelist check
    ext = p.suffix.lstrip(".").lower()
    if ext and ext not in SAFE_EXTENSIONS:
        warnings.append(
            f"⚠ Extension không nằm trong whitelist: .{ext} "
            f"(File: {p.name})"
        )

    # 4. Double extension detection (chống file giả mạo như video.mp4.exe)
    name_parts = p.name.rsplit(".", maxsplit=3)
    if len(name_parts) >= 3:
        suspicious_exts = {"exe", "bat", "cmd", "sh", "ps1", "vbs", "js",
                           "msi", "dll", "scr", "com", "pif", "hta", "desktop"}
        for part in name_parts[1:]:
            if part.lower() in suspicious_exts:
                warnings.append(
                    f"🚨 NGUY HIỂM: Phát hiện double extension đáng ngờ: {p.name}"
                )
                break

    # Đọc header kiểm tra chữ ký nhị phân
    header = b""
    try:
        with open(filepath, "rb") as f:
            header = f.read(32)  # Đọc 32 bytes đầu
    except (OSError, PermissionError):
        pass

    # 5. Quét chữ ký nhị phân thực thi độc hại (Executable Header Injection)
    for bad_sig, desc in DANGEROUS_MAGIC_HEADERS:
        if header.startswith(bad_sig):
            warnings.append(
                f"🚨 NGUY HIỂM TỐI CAO: File chứa chữ ký thực thi nhị phân ({desc}) giả mạo media! (File: {p.name})"
            )
            break

    # 6. Magic bytes validation
    if ext in MAGIC_BYTES_MAP and header:
        expected_sigs = MAGIC_BYTES_MAP[ext]
        matched = False
        for sig in expected_sigs:
            if sig in header[:16]:
                matched = True
                break

        if not matched and len(header) >= 4:
            # Đặc biệt cho MP4/M4A: kiểm tra 'ftyp' tại offset 4
            if ext in ("mp4", "m4a") and b"ftyp" in header[:12]:
                matched = True

        if not matched and len(header) >= 4:
            warnings.append(
                f"⚠ Magic bytes không khớp extension .{ext}: "
                f"File có thể bị giả mạo hoặc hỏng (File: {p.name})"
            )

    # 7. File size anomaly check
    try:
        file_size = p.stat().st_size
        if file_size == 0:
            warnings.append(f"⚠ File rỗng (0 bytes): {p.name}")
        elif file_size > MAX_FILESIZE_BYTES:
            warnings.append(
                f"⚠ File vượt giới hạn dung lượng ({format_bytes(file_size)}): {p.name}"
            )
    except OSError:
        pass

    is_safe = not any("🚨" in w for w in warnings)
    return is_safe, warnings


def validate_downloaded_files(save_dir: str, prefix: str) -> tuple[bool, list[str]]:
    """
    Quét toàn bộ file mới tải trong thư mục save_dir có prefix phù hợp.
    Trả về (all_safe, combined_warnings).
    """
    all_warnings: list[str] = []
    all_safe = True

    p_dir = Path(save_dir)
    if not p_dir.is_dir():
        return True, []

    for f in p_dir.iterdir():
        if f.is_file() and f.name.startswith(prefix):
            safe, warnings = validate_file_integrity(str(f))
            all_warnings.extend(warnings)
            if not safe:
                all_safe = False

    return all_safe, all_warnings


def safe_open_path(path: str, open_file: bool = False) -> bool:
    """
    Mở thư mục hoặc file bằng xdg-open trên Linux.

    BẢO MẬT:
    - Dùng subprocess.Popen với shell=False (KHÔNG shell injection)
    - Validate path tồn tại trước khi mở
    - Chỉ cho phép mở file với extension nằm trong SAFE_EXTENSIONS
    - Không thực thi file, chỉ mở bằng ứng dụng mặc định
    """
    p = Path(path)

    if open_file:
        # Validate: chỉ mở file an toàn
        if not p.is_file():
            return False
        ext = p.suffix.lstrip(".").lower()
        if ext not in SAFE_EXTENSIONS:
            return False
        target = str(p.resolve())
    else:
        # Mở thư mục
        if p.is_file():
            target = str(p.parent.resolve())
        elif p.is_dir():
            target = str(p.resolve())
        else:
            return False

    try:
        # shell=False → an toàn, không có shell injection
        subprocess.Popen(
            ["xdg-open", target],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return True
    except (FileNotFoundError, OSError):
        return False


def safe_notify(title: str, message: str) -> bool:
    """
    Gửi thông báo hệ thống qua notify-send (Linux Desktop Notification).
    BẢO MẬT: shell=False, sanitize input text.
    """
    # Sanitize: loại bỏ ký tự điều khiển có thể gây injection
    safe_title = re.sub(r"[<>&;|`$]", "", title)[:100]
    safe_msg = re.sub(r"[<>&;|`$]", "", message)[:300]
    try:
        subprocess.Popen(
            ["notify-send", "--app-name=MediaDownloader", safe_title, safe_msg],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return True
    except (FileNotFoundError, OSError):
        return False


def is_safe_remote_url(url: str, allow_private: bool = False) -> bool:
    """
    Kiểm tra URL an toàn:
    - Scheme phải là http hoặc https
    - Chống SSRF: Chặn loopback, private IP (127.0.0.1, 10.x, 192.168.x...) trừ khi allow_private=True
    - Chống Command Injection & ký tự điều khiển
    """
    if not url or not isinstance(url, str):
        return False
    url = url.strip()
    if len(url) > MAX_CLIPBOARD_LENGTH:
        return False
    if any(c in url for c in ['\x00', '\r', '\n', '`', '$', '|', '<', '>', '"', '{', '}']):
        return False
    try:
        parsed = urlparse(url)
        if parsed.scheme not in ("http", "https"):
            return False
        hostname = (parsed.hostname or "").lower()
        if not hostname:
            return False
        if not allow_private:
            if hostname in ("localhost", "127.0.0.1", "::1", "0.0.0.0"):
                return False
            if hostname.endswith((".local", ".localhost", ".internal", ".lan")):
                return False
            import ipaddress
            try:
                ip = ipaddress.ip_address(hostname)
                if ip.is_private or ip.is_loopback or ip.is_link_local or ip.is_reserved:
                    return False
            except ValueError:
                pass
        return True
    except Exception:
        return False


def is_direct_image_url(url: str) -> bool:
    """Kiểm tra URL có phải là liên kết hình ảnh trực tiếp (PNG, JPG, GIF, WebP, JNG, BMP...)."""
    if not url or not isinstance(url, str):
        return False
    url_clean = url.strip()
    try:
        parsed = urlparse(url_clean)
        if parsed.scheme not in ("http", "https"):
            return False
        path = parsed.path.lower()
        if any(path.endswith(f".{ext}") for ext in SUPPORTED_IMAGE_EXTS):
            return True
        # Kiểm tra query param (ví dụ format=png hoặc ext=gif)
        if re.search(r"[?&](?:format|ext|f)=([a-zA-Z0-9]+)", parsed.query, re.IGNORECASE):
            m = re.search(r"[?&](?:format|ext|f)=([a-zA-Z0-9]+)", parsed.query, re.IGNORECASE)
            if m and m.group(1).lower() in SUPPORTED_IMAGE_EXTS:
                return True
        # CDN image match (bao gồm cả Twitter CDN pbs.twimg.com/media/...)
        if "pbs.twimg.com/media/" in url_clean.lower():
            return True
        if re.search(r"\.(png|jpe?g|gif|webp|bmp|svg|ico|jfif|jng)\b", url_clean, re.IGNORECASE):
            return True
        return False
    except Exception:
        return False


def is_direct_media_url(url: str) -> bool:
    """Kiểm tra URL có phải là liên kết Video hoặc Audio trực tiếp (MP4, WebM, MP3...)."""
    if not url or not isinstance(url, str):
        return False
    url_clean = url.strip()
    try:
        parsed = urlparse(url_clean)
        if parsed.scheme not in ("http", "https"):
            return False
        path = parsed.path.lower()
        return any(path.endswith(f".{ext}") for ext in SUPPORTED_MEDIA_EXTS)
    except Exception:
        return False


def is_rule34_url(url: str) -> bool:
    """Kiểm tra URL từ Rule34 hoặc các trang Booru phổ biến (rule34.xxx, rule34video, gelbooru...)."""
    if not url or not isinstance(url, str):
        return False
    url_l = url.strip().lower()
    return bool(
        "rule34.xxx" in url_l
        or "rule34video.com" in url_l
        or "rule34.paheal.net" in url_l
        or "gelbooru.com" in url_l
        or "danbooru.donmai.us" in url_l
        or "safebooru.org" in url_l
        or "yande.re" in url_l
        or "konachan.com" in url_l
        or "e-shuushuu.net" in url_l
        or RE_RULE34.match(url)
        or RE_BOORU_OTHER.match(url)
    )


def is_iwara_url(url: str) -> bool:
    """Kiểm tra URL từ Iwara (iwara.tv)."""
    if not url or not isinstance(url, str):
        return False
    url_l = url.strip().lower()
    return "iwara.tv" in url_l or bool(RE_IWARA.match(url))


def is_telegram_url(url: str) -> bool:
    """Kiểm tra URL từ Telegram (t.me, telegram.me, telesco.pe)."""
    if not url or not isinstance(url, str):
        return False
    url_l = url.strip().lower()
    return bool(
        "t.me/" in url_l
        or "telegram.me/" in url_l
        or "telesco.pe/" in url_l
        or RE_TELEGRAM.match(url)
    )


def is_pinterest_url(url: str) -> bool:
    """Kiểm tra URL có thuộc nền tảng Pinterest (pinterest.com, pin.it, i.pinimg.com...)."""
    if not url or not isinstance(url, str):
        return False
    url_l = url.strip().lower()
    return bool(
        "pinterest." in url_l
        or "pin.it/" in url_l
        or "pinimg.com" in url_l
        or RE_PINTEREST.match(url)
    )


# ═══════════════════════════════════════════════════════════════════════════════
# URL AUTO-DETECTION (Nhận diện nền tảng tự động)
# ═══════════════════════════════════════════════════════════════════════════════

def auto_detect_platform(url: str) -> Optional[str]:
    """
    Tự động nhận diện nền tảng từ URL.
    Trả về tên nền tảng hiển thị (dùng cho combobox) hoặc None nếu không nhận diện được.

    BẢO MẬT: Kiểm tra tính hợp lệ và an toàn của URL trước khi trả về.
    """
    if not url or not isinstance(url, str):
        return None

    url = url.strip()
    if len(url) > MAX_CLIPBOARD_LENGTH:
        return None

    # 1. Nhận diện hình ảnh trực tiếp (PNG, JPG, GIF, WebP, JNG, BMP...)
    # Ngoại lệ: Nếu là link của booru/rule34 thì ưu tiên rule34 post handler
    if is_rule34_url(url):
        return "Rule34 / Booru (Image & Video)"

    if is_pinterest_url(url):
        return "Pinterest (Pin & Image)"

    if is_direct_image_url(url):
        return "Hình ảnh trực tiếp (PNG/JPG/GIF...)"

    # 2. Nhận diện Iwara
    if is_iwara_url(url):
        return "Iwara (iwara.tv)"

    # 3. Nhận diện Telegram
    if is_telegram_url(url):
        return "Telegram (t.me)"

    # 4. Nhận diện các nền tảng mạng xã hội phổ biến
    if RE_YOUTUBE.match(url):
        return "YouTube"
    if RE_TWITTER.match(url):
        return "Twitter / X"
    if RE_FACEBOOK.match(url):
        return "Facebook"
    if RE_TIKTOK.match(url):
        return "TikTok"
    if RE_INSTAGRAM.match(url):
        return "Instagram"
    if RE_REDDIT.match(url):
        return "Reddit"
    if RE_BILIBILI.match(url):
        return "Bilibili"
    if RE_ZINGMP3.match(url):
        return "Zing MP3"
    if RE_SPOTIFY.match(url):
        return "Spotify"
    if RE_LOCAL_STREAM.match(url):
        return "Local Lab / Custom Stream (HLS/DASH)"

    # 5. Nhận diện Media trực tiếp (MP4, WebM, MP3...)
    if is_direct_media_url(url):
        return "Media trực tiếp (MP4/WebM/MP3...)"

    # 6. Playlist YouTube detection (URL chứa list=)
    if re.match(
        r"^https?://(?:(?:www|m|music)\.)?youtube\.com/(?:playlist\?|watch\?.*list=)",
        url,
    ):
        return "YouTube"

    # 7. Nhận diện tổng quát cho các nền tảng khác (Reddit, Vimeo, Twitch, Pinterest, etc.)
    if is_safe_remote_url(url):
        return "Nền tảng khác / Universal (yt-dlp)"

    return None


# ═══════════════════════════════════════════════════════════════════════════════
# PLAYLIST EXTRACTION & EXPANSION ENGINE
# ═══════════════════════════════════════════════════════════════════════════════

def is_playlist_url(url: str) -> tuple[bool, str]:
    """
    Xác định URL có phải là Playlist / Album hay không.
    Trả về (is_playlist, platform_code).
    """
    if not url or not isinstance(url, str):
        return False, ""

    url = url.strip()
    if ("youtube.com" in url or "music.youtube.com" in url) and (
        "playlist?list=" in url or "&list=" in url or "?list=" in url
    ):
        return True, "youtube"

    if "spotify.com" in url and ("/playlist/" in url or "/album/" in url):
        return True, "spotify"

    if "zingmp3.vn" in url and ("/album/" in url or "/playlist/" in url):
        return True, "zingmp3"

    return False, ""


def extract_youtube_playlist(
    url: str,
    max_items: int = MAX_PLAYLIST_ITEMS,
    cookie_browser: Optional[str] = None,
    cookie_file: Optional[str] = None,
) -> tuple[dict, list[dict]]:
    """Trích xuất danh sách video từ Playlist YouTube mà không tải dữ liệu."""
    if YoutubeDL is None:
        return {}, []
    opts: dict = {
        "extract_flat": True,
        "quiet": True,
        "noplaylist": False,
        "playlist_items": f"1:{max_items}",
        "socket_timeout": 15,
        "ignoreerrors": True,
    }
    if cookie_browser:
        opts["cookiesfrombrowser"] = (cookie_browser,)
    elif cookie_file and Path(cookie_file).is_file():
        opts["cookiefile"] = str(cookie_file)

    try:
        with YoutubeDL(opts) as ydl:
            info = ydl.extract_info(url, download=False)
            if not info:
                return {}, []

        playlist_title = info.get("title") or "YouTube Playlist"
        playlist_author = info.get("uploader") or info.get("channel") or "Không rõ"
        entries = []
        raw_entries = info.get("entries") or []
        for e in raw_entries:
            if not e:
                continue
            vid_id = e.get("id")
            vid_url = e.get("url") or (f"https://www.youtube.com/watch?v={vid_id}" if vid_id else "")
            if not vid_url:
                continue
            entries.append({
                "id": vid_id or "",
                "url": vid_url,
                "title": e.get("title") or f"Video {vid_id}",
                "duration": e.get("duration"),
                "uploader": e.get("uploader") or playlist_author,
                "platform": "YouTube",
                "target": "youtube",
            })
        meta = {
            "title": playlist_title,
            "author": playlist_author,
            "total": len(entries),
            "thumbnail": info.get("thumbnail"),
        }
        return meta, entries
    except Exception:
        return {}, []


def resolve_spotify_playlist_or_album(
    url: str,
    max_items: int = MAX_PLAYLIST_ITEMS,
) -> tuple[dict, list[dict]]:
    """Trích xuất danh sách bài hát từ Spotify Playlist hoặc Album qua Embed JSON."""
    m = re.search(r"spotify\.com/(?:intl-[a-z]{2}/)?(playlist|album)/([a-zA-Z0-9]+)", url)
    if not m:
        return {}, []
    p_type, p_id = m.group(1), m.group(2)
    embed_url = f"https://open.spotify.com/embed/{p_type}/{p_id}"
    headers = {
        "User-Agent": (
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
            "AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
        )
    }
    try:
        if HAS_REQUESTS:
            resp = requests.get(embed_url, timeout=10, headers=headers)
            html = resp.text
        else:
            req = urllib.request.Request(embed_url, headers=headers)
            with urllib.request.urlopen(req, timeout=10) as r:
                html = r.read().decode("utf-8", errors="ignore")

        m_data = re.search(r'<script id="__NEXT_DATA__" type="application/json">(.*?)</script>', html)
        if not m_data:
            return {}, []

        data = json.loads(m_data.group(1))
        entity = (
            data.get("props", {})
            .get("pageProps", {})
            .get("state", {})
            .get("data", {})
            .get("entity", {})
        )
        title = entity.get("name") or entity.get("title") or f"Spotify {p_type.capitalize()}"
        subtitle = entity.get("subtitle") or entity.get("type", "Spotify")
        cover_art = entity.get("visualIdentity", {}).get("image", [{}])
        thumbnail = cover_art[0].get("url") if cover_art else None

        track_list = entity.get("trackList", [])
        entries = []
        for t in track_list[:max_items]:
            uri = t.get("uri") or ""
            t_id = uri.split(":")[-1] if ":" in uri else ""
            t_url = f"https://open.spotify.com/track/{t_id}" if t_id else ""
            t_title = t.get("title") or "Unknown Track"
            t_artist = t.get("subtitle") or subtitle
            dur = (t.get("duration") or 0) / 1000.0 if t.get("duration") else None
            if t_url:
                entries.append({
                    "id": t_id,
                    "url": t_url,
                    "title": f"{t_artist} - {t_title}" if t_artist else t_title,
                    "duration": dur,
                    "uploader": t_artist,
                    "platform": "Spotify",
                    "target": "spotify",
                })
        meta = {
            "title": title,
            "author": subtitle,
            "thumbnail": thumbnail,
            "total": len(entries),
        }
        return meta, entries
    except Exception:
        return {}, []


def extract_zingmp3_playlist(
    url: str,
    max_items: int = MAX_PLAYLIST_ITEMS,
) -> tuple[dict, list[dict]]:
    """Trích xuất danh sách bài hát từ Zing MP3 Album / Playlist."""
    if YoutubeDL is None:
        return {}, []
    opts = {
        "extract_flat": True,
        "quiet": True,
        "noplaylist": False,
        "playlist_items": f"1:{max_items}",
        "socket_timeout": 15,
        "ignoreerrors": True,
    }
    try:
        with YoutubeDL(opts) as ydl:
            info = ydl.extract_info(url, download=False)
            if not info:
                return {}, []
        playlist_title = info.get("title") or "Zing MP3 Album"
        playlist_author = info.get("uploader") or info.get("artist") or "Không rõ"
        entries = []
        for e in (info.get("entries") or []):
            if not e:
                continue
            vid_url = e.get("url") or e.get("webpage_url") or ""
            if not vid_url:
                continue
            entries.append({
                "id": e.get("id") or "",
                "url": vid_url,
                "title": e.get("title") or "Bài hát Zing MP3",
                "duration": e.get("duration"),
                "uploader": e.get("uploader") or playlist_author,
                "platform": "Zing MP3",
                "target": "zingmp3",
            })
        meta = {
            "title": playlist_title,
            "author": playlist_author,
            "total": len(entries),
            "thumbnail": info.get("thumbnail"),
        }
        return meta, entries
    except Exception:
        return {}, []


def extract_playlist_items(
    url: str,
    target: str,
    max_items: int = MAX_PLAYLIST_ITEMS,
    cookie_browser: Optional[str] = None,
    cookie_file: Optional[str] = None,
) -> tuple[dict, list[dict]]:
    """Hàm điều phối trích xuất playlist theo nền tảng mục tiêu."""
    if target == "youtube" or "youtube.com" in url or "youtu.be" in url:
        return extract_youtube_playlist(url, max_items, cookie_browser, cookie_file)
    elif target == "spotify" or "spotify.com" in url:
        return resolve_spotify_playlist_or_album(url, max_items)
    elif target == "zingmp3" or "zingmp3.vn" in url:
        return extract_zingmp3_playlist(url, max_items)
    return {}, []


# ═══════════════════════════════════════════════════════════════════════════════
# DIRECT IMAGE, PINTEREST, RULE34 & TELEGRAM RESOLVERS & DOWNLOADING
# ═══════════════════════════════════════════════════════════════════════════════

def upgrade_pinimg_url(url: str) -> tuple[str, str, int]:
    """
    Nâng cấp URL ảnh Pinterest (i.pinimg.com) từ thumbnail/preview thu nhỏ (236x, 474x, 564x, 736x, 1200x)
    lên chất lượng Master nguyên bản (originals) đạt độ phân giải và sắc nét 99-100% tối đa.
    Trả về (best_url, ext, filesize).
    """
    m = re.match(r"https?://i\.pinimg\.com/([^/]+)/(.+?)\.([a-zA-Z0-9]+)(?:\?.*)?$", url)
    if not m:
        return url, "jpg", 0
    size_part, rel_path, ext = m.groups()
    headers = {
        "User-Agent": (
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
            "AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
        ),
        "Accept": "image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8",
        "Referer": "https://www.pinterest.com/",
    }
    candidates = [
        f"https://i.pinimg.com/originals/{rel_path}.webp",
        f"https://i.pinimg.com/originals/{rel_path}.png",
        f"https://i.pinimg.com/originals/{rel_path}.jpg",
        f"https://i.pinimg.com/originals/{rel_path}.{ext}",
        f"https://i.pinimg.com/1200x/{rel_path}.{ext}",
        f"https://i.pinimg.com/736x/{rel_path}.{ext}",
        url,
    ]
    seen = set()
    for cand in candidates:
        if cand in seen:
            continue
        seen.add(cand)
        try:
            req = urllib.request.Request(cand, headers=headers, method="HEAD")
            with urllib.request.urlopen(req, timeout=4) as resp:
                if resp.status == 200:
                    cl = int(resp.headers.get("Content-Length", 0))
                    c_ext = cand.split("?")[0].split(".")[-1].lower()
                    return cand, c_ext, cl
        except Exception:
            continue
    return url, ext.lower(), 0


def resolve_pinterest_media(
    url: str,
    cookie_browser: Optional[str] = None,
    cookie_file: Optional[str] = None,
) -> Optional[dict]:
    """
    Trích xuất hình ảnh hoặc video gốc chất lượng cao nhất từ Pinterest (Pin & CDN):
    - Hỗ trợ các link dạng:
      • https://www.pinterest.com/pin/1146166174086802345/
      • https://pin.it/XXXXXX (tự động giải phóng link rút gọn)
      • https://i.pinimg.com/... (tự động nâng cấp lên Originals WebP/PNG/JPG Master)
    - Tự động dò tìm phân giải cao nhất (Originals / 1200x), loại bỏ giới hạn preview.
    - Đạt chuẩn sắc nét ~99-100% so với ảnh hiển thị trên Web.
    """
    if not is_safe_remote_url(url):
        return None

    headers = {
        "User-Agent": (
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
            "AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
        ),
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
        "Accept-Language": "vi,en-US;q=0.9,en;q=0.8",
        "Referer": "https://www.pinterest.com/",
    }

    # 1. Giải quyết link rút gọn pin.it
    if "pin.it/" in url:
        try:
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=8) as resp:
                url = resp.geturl()
        except Exception:
            pass

    # 2. Xử lý direct CDN i.pinimg.com
    if "i.pinimg.com" in url:
        best_url, ext, content_len = upgrade_pinimg_url(url)
        path_hash = hashlib.md5(url.encode()).hexdigest()[:10]
        m_part = re.search(r"i\.pinimg\.com/[^/]+/(.+?)\.[a-zA-Z0-9]+", url)
        raw_id = m_part.group(1).replace("/", "_") if m_part else path_hash
        return {
            "id": raw_id,
            "title": f"Pinterest Master Image #{raw_id.split('_')[-1]}",
            "media_url": best_url,
            "media_type": "image",
            "ext": ext,
            "filesize": content_len,
            "thumbnail": best_url,
            "uploader": "Pinterest CDN",
        }

    # 3. Xử lý Pin URL (pinterest.com/pin/<id>)
    pin_id_match = re.search(r"/pin/(\d+)", url)
    pin_id = pin_id_match.group(1) if pin_id_match else hashlib.md5(url.encode()).hexdigest()[:10]

    html = ""
    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=10) as resp:
            html = resp.read().decode("utf-8", errors="ignore")
    except Exception:
        pass

    if not html:
        return None

    # Tiêu đề
    title = f"Pinterest Pin #{pin_id}"
    t_match = re.search(r"<title>([^<]+)</title>", html)
    if t_match:
        t = t_match.group(1).split("|")[0].strip()
        if t and "pinterest" not in t.lower():
            title = t
    meta_title = re.search(r'<meta[^>]+property=[\"\']og:title[\"\'][^>]+content=[\"\']([^\"\']+)[\"\']', html)
    if meta_title and meta_title.group(1).strip():
        title = meta_title.group(1).strip()

    # Kiểm tra xem có video không
    video_matches = re.findall(r'https?://v\.pinimg\.com/videos/[^\s\"\'<>]+\.mp4', html)
    if not video_matches:
        video_matches = re.findall(r'https?://[^\s\"\'<>]+\.mp4', html)
    if video_matches:
        best_vid = video_matches[0]
        for v in video_matches:
            if "1080p" in v.lower() or "720p" in v.lower() or "exp7" in v.lower():
                best_vid = v
                break
        return {
            "id": pin_id,
            "title": title,
            "media_url": best_vid,
            "media_type": "video",
            "ext": "mp4",
            "filesize": 0,
            "thumbnail": "",
            "uploader": "Pinterest Video",
        }

    # 1. Trích xuất ảnh chính qua JSON-LD schema (chính xác 100% không dính CSS/icon)
    pin_img = None
    json_ld_matches = re.findall(r'<script[^>]+type=[\"\']application/ld\+json[\"\'][^>]*>(.*?)</script>', html, re.DOTALL)
    for j in json_ld_matches:
        try:
            data = json.loads(j)
            img = data.get("image")
            if img and isinstance(img, str) and "pinimg.com" in img:
                pin_img = img
                break
        except Exception:
            pass

    # 2. Trích xuất qua link preload hoặc og:image
    if not pin_img:
        preload_matches = re.findall(r'<link[^>]+rel=[\"\']preload[\"\'][^>]+href=[\"\'](https://i\.pinimg\.com/[^\"\']+)[\"\']', html)
        if preload_matches:
            pin_img = preload_matches[0]
        else:
            og_imgs = re.findall(r'<meta[^>]+property=[\"\']og:image[\"\'][^>]+content=[\"\']([^\"\']+)[\"\']', html)
            if og_imgs:
                pin_img = og_imgs[0]

    if pin_img:
        best_url, best_ext, best_len = upgrade_pinimg_url(pin_img)
        return {
            "id": pin_id,
            "title": title,
            "media_url": best_url,
            "media_type": "image",
            "ext": best_ext,
            "filesize": best_len,
            "thumbnail": best_url,
            "uploader": "Pinterest",
        }

    # 3. Fallback: Thu thập các URL ảnh khác từ HTML (loại bỏ css, sprite, icon)
    orig_matches = re.findall(r'https://i\.pinimg\.com/originals/[a-zA-Z0-9/_.-]+\.(?:webp|jpg|jpeg|png)', html)
    x1200_matches = re.findall(r'https://i\.pinimg\.com/1200x/[a-zA-Z0-9/_.-]+\.(?:webp|jpg|jpeg|png)', html)
    x736_matches = re.findall(r'https://i\.pinimg\.com/736x/[a-zA-Z0-9/_.-]+\.(?:webp|jpg|jpeg|png)', html)

    raw_candidates = orig_matches + x1200_matches + x736_matches
    expanded_candidates = []
    for cand in raw_candidates:
        cand_clean = cand.split("?")[0].strip()
        if any(bad in cand_clean for bad in ["_RS", "board_thumbnail", "avatar", "icon"]):
            continue
        if "i.pinimg.com" in cand_clean:
            m = re.match(r"https?://i\.pinimg\.com/([^/]+)/(.+?)\.([a-zA-Z0-9]+)", cand_clean)
            if m:
                _, rel_p, orig_e = m.groups()
                expanded_candidates.append(f"https://i.pinimg.com/originals/{rel_p}.webp")
                expanded_candidates.append(f"https://i.pinimg.com/originals/{rel_p}.png")
                expanded_candidates.append(f"https://i.pinimg.com/originals/{rel_p}.jpg")
                expanded_candidates.append(f"https://i.pinimg.com/originals/{rel_p}.{orig_e}")
                expanded_candidates.append(f"https://i.pinimg.com/1200x/{rel_p}.{orig_e}")
                expanded_candidates.append(f"https://i.pinimg.com/736x/{rel_p}.{orig_e}")
        expanded_candidates.append(cand_clean)

    # Deduplicate giữ nguyên thứ tự ưu tiên
    seen = set()
    cands_to_probe = []
    for c in expanded_candidates:
        if c not in seen and c.startswith("http"):
            seen.add(c)
            cands_to_probe.append(c)

    best_url = None
    best_len = 0
    best_ext = "jpg"

    for cand in cands_to_probe:
        try:
            req = urllib.request.Request(cand, headers=headers, method="HEAD")
            with urllib.request.urlopen(req, timeout=4) as resp:
                if resp.status == 200:
                    cl = int(resp.headers.get("Content-Length", 0))
                    best_url = cand
                    best_len = cl
                    best_ext = cand.split("?")[0].split(".")[-1].lower()
                    break
        except Exception:
            continue

    if not best_url and cands_to_probe:
        best_url = cands_to_probe[0]
        best_ext = best_url.split("?")[0].split(".")[-1].lower()

    if best_url:
        return {
            "id": pin_id,
            "title": title,
            "media_url": best_url,
            "media_type": "image",
            "ext": best_ext,
            "filesize": best_len,
            "thumbnail": best_url,
            "uploader": "Pinterest",
        }
    return None


def resolve_direct_image_info(url: str) -> Optional[dict]:
    """
    Trích xuất thông tin ảnh trực tiếp (PNG, JPG, GIF, WebP, JNG, BMP, SVG...):
    - Đọc dung lượng (Content-Length)
    - Đọc metadata & dimensions ảnh qua Pillow (PIL)
    - Trả về metadata an toàn
    """
    if not is_safe_remote_url(url):
        return None
    try:
        # Tự động nâng cấp nếu là link ảnh CDN Pinterest (i.pinimg.com)
        if "i.pinimg.com" in url:
            up_url, up_ext, up_sz = upgrade_pinimg_url(url)
            if up_url != url:
                url = up_url
        # Tự động nâng cấp nếu là link ảnh Twitter/X (pbs.twimg.com/media/...)
        elif "pbs.twimg.com/media/" in url:
            up_url = upgrade_twitter_image_url(url, prefer_png=True)
            if up_url != url:
                url = up_url
        parsed = urlparse(url)
        path = parsed.path
        raw_name = Path(path).name or "image"
        # Bóc tách extension
        ext = ""
        for possible_ext in SUPPORTED_IMAGE_EXTS:
            if path.lower().endswith(f".{possible_ext}"):
                ext = possible_ext
                break
        if not ext:
            m = re.search(r"[?&](?:format|ext|f)=([a-zA-Z0-9]+)", parsed.query, re.IGNORECASE)
            if m and m.group(1).lower() in SUPPORTED_IMAGE_EXTS:
                ext = m.group(1).lower()
            else:
                ext = "png"

        headers = {
            "User-Agent": (
                "Mozilla/5.0 (X11; Linux x86_64; rv:120.0) "
                "Gecko/20100101 Firefox/120.0"
            ),
            "Accept": "image/avif,image/webp,image/apng,image/svg+xml,image/*,*/*;q=0.8",
        }
        total_size = 0
        img_w, img_h = 0, 0
        img_format = ext.upper()
        chunk = b""

        if HAS_REQUESTS:
            try:
                with requests.get(url, headers=headers, stream=True, timeout=10) as resp:
                    if resp.status_code == 200:
                        cl = resp.headers.get("content-length")
                        if cl and cl.isdigit():
                            total_size = int(cl)
                        chunk = resp.raw.read(65536)
            except Exception:
                chunk = b""

        if not chunk:
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=10) as resp:
                cl = resp.headers.get("Content-Length")
                if cl and cl.isdigit():
                    total_size = int(cl)
                chunk = resp.read(65536)

        if HAS_PIL and chunk:
            try:
                with Image.open(io.BytesIO(chunk)) as img:
                    img_w, img_h = img.size
                    img_format = img.format or ext.upper()
            except Exception:
                pass

        dim_str = f"{img_w}x{img_h} px" if img_w and img_h else ""
        url_hash = hashlib.md5(url.encode()).hexdigest()[:8]
        title = f"{raw_name}" if raw_name and len(raw_name) < 80 else f"image_{url_hash}.{ext}"

        return {
            "title": title,
            "uploader": parsed.netloc,
            "filesize": total_size,
            "dimensions": dim_str,
            "format": img_format,
            "ext": ext,
            "thumbnail": url,
            "url": url,
        }
    except Exception:
        return None


def resolve_rule34_post(url: str) -> Optional[dict]:
    """
    Trích xuất bài đăng từ Rule34 hoặc các Booru tương tự (rule34.xxx, rule34.paheal.net, gelbooru, etc.).
    Hỗ trợ cả link post view lẫn link file ảnh/video trực tiếp (wimg.rule34.xxx/images/...).
    """
    if not is_safe_remote_url(url):
        return None
    url_l = url.lower()
    # Nếu là link media trực tiếp của Rule34/Booru (ví dụ: wimg.rule34.xxx/images/...)
    if any(f".{ext}" in url_l for ext in ("jpg", "jpeg", "png", "gif", "mp4", "webm")) and (
        "rule34" in url_l or "booru" in url_l
    ):
        ext = "mp4" if (".mp4" in url_l or ".webm" in url_l) else "jpg"
        for e in ("png", "gif", "jpeg", "jpg", "webm", "mp4"):
            if f".{e}" in url_l:
                ext = e
                break
        is_video = ext in ("mp4", "webm")
        return {
            "id": hashlib.md5(url.encode()).hexdigest()[:10],
            "title": f"Rule34 Media ({Path(urlparse(url).path).name})",
            "uploader": "Rule34 CDN",
            "media_url": url,
            "media_type": "video" if is_video else "image",
            "thumbnail": url if not is_video else None,
            "ext": ext,
            "tags": [],
        }

    # Nếu là post view booru (ví dụ: rule34.xxx/index.php?page=post&s=view&id=12345)
    m_id = re.search(r"[?&]id=(\d+)", url) or re.search(r"/view/(\d+)", url) or re.search(r"/posts?/(\d+)", url)
    post_id = m_id.group(1) if m_id else "unknown"

    headers = {
        "User-Agent": (
            "Mozilla/5.0 (X11; Linux x86_64; rv:120.0) "
            "Gecko/20100101 Firefox/120.0"
        )
    }
    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=12) as resp:
            html = resp.read().decode("utf-8", errors="ignore")

        # 1. Tìm Original Image link từ các mẫu phổ biến của Booru
        media_url = ""
        m_orig = re.search(
            r'<a[^>]+href=["\'](https?://[^"\']+\.(?:jpg|jpeg|png|gif|mp4|webm)[^"\']*)["\'][^>]*>\s*Original image',
            html,
            re.IGNORECASE,
        )
        if m_orig:
            media_url = m_orig.group(1)

        # Thẻ meta og:image
        if not media_url:
            m_og = re.search(
                r'<meta\s+property=["\']og:image["\']\s+content=["\']([^"\']+)["\']',
                html,
                re.IGNORECASE,
            )
            if m_og and not m_og.group(1).endswith("favicon.ico"):
                media_url = m_og.group(1)

        # Thẻ video
        if not media_url:
            m_vid = re.search(
                r'<video[^>]*>.*?<source[^>]+src=["\']([^"\']+)["\']',
                html,
                re.DOTALL | re.IGNORECASE,
            )
            if m_vid:
                media_url = m_vid.group(1)

        # Thẻ img id=image
        if not media_url:
            m_img = re.search(
                r'<img[^>]+id=["\']image["\'][^>]+src=["\']([^"\']+)["\']',
                html,
                re.IGNORECASE,
            )
            if m_img:
                media_url = m_img.group(1)

        # Trích xuất từ JavaScript image object
        if not media_url:
            m_js = re.search(
                r"image\s*=\s*\{[^}]*['\"]domain['\"]\s*:\s*['\"]([^'\"]+)['\"][^}]*['\"]dir['\"]\s*:\s*(\d+)[^}]*['\"]img['\"]\s*:\s*['\"]([^'\"]+)['\"]",
                html,
            )
            if m_js:
                domain, directory, img_name = m_js.groups()
                domain = domain.rstrip("/")
                media_url = f"{domain}//images/{directory}/{img_name}"

        # URL fallback: tìm link CDN
        if not media_url:
            found_urls = re.findall(
                r'https?://[^\s"\'<>]+\.(?:jpg|jpeg|png|gif|mp4|webm)(?:\?[^\s"\'<>]*)?',
                html,
                re.IGNORECASE,
            )
            for u in found_urls:
                if "images" in u or "sample" in u or "thumbnails" in u:
                    media_url = u
                    break

        if not media_url:
            return None

        # Clean URL
        if media_url.startswith("//"):
            media_url = "https:" + media_url

        ext = "jpg"
        for e in ("png", "gif", "jpeg", "jpg", "webm", "mp4"):
            if f".{e}" in media_url.lower():
                ext = e
                break

        is_video = ext in ("mp4", "webm")

        # Tags
        tags = re.findall(r'<li class=["\']tag-type-[^"\']*["\'][^>]*>.*?<a[^>]*>([^<]+)</a>', html, re.DOTALL)
        clean_tags = [t.strip() for t in tags if t.strip() and t.strip() != "?"]

        return {
            "id": post_id,
            "title": f"Rule34 Post #{post_id}",
            "uploader": "Rule34" if "rule34" in url_l else "Booru",
            "media_url": media_url,
            "media_type": "video" if is_video else "image",
            "thumbnail": media_url if not is_video else None,
            "ext": ext,
            "tags": clean_tags[:8],
        }
    except Exception:
        return None


def resolve_telegram_media(url: str) -> Optional[dict]:
    """
    Trích xuất media (Video hoặc Hình ảnh) từ liên kết Telegram (t.me).
    Sử dụng Web Embed Widget chính thức của Telegram (https://t.me/<channel>/<id>?embed=1).
    """
    if not is_safe_remote_url(url):
        return None
    try:
        clean_url = url.split("?")[0].rstrip("/")
        embed_url = clean_url + "?embed=1"
        m = re.search(r"t\.me/(?:c/\d+/|)([^/]+)/(\d+)", clean_url)
        channel = m.group(1) if m else "Telegram"
        post_id = m.group(2) if m else hashlib.md5(url.encode()).hexdigest()[:6]

        headers = {
            "User-Agent": (
                "Mozilla/5.0 (X11; Linux x86_64; rv:120.0) "
                "Gecko/20100101 Firefox/120.0"
            )
        }
        req = urllib.request.Request(embed_url, headers=headers)
        with urllib.request.urlopen(req, timeout=12) as resp:
            html = resp.read().decode("utf-8", errors="ignore")

        # 1. Tìm video
        m_vid = re.search(r'<video[^>]+src=["\']([^"\']+)["\']', html)
        media_url = ""
        media_type = "image"
        ext = "jpg"
        if m_vid:
            media_url = m_vid.group(1)
            media_type = "video"
            ext = "mp4"

        # 2. Nếu không có video, tìm ảnh background-image
        all_photos: list[str] = []
        if not media_url:
            m_photos = re.findall(r"background-image:url\(['\"]?([^'\"]+)['\"]?\)", html)
            for photo in m_photos:
                if ("telegram" in photo or "telesco.pe" in photo or "cdn" in photo) and "avatar" not in photo.lower():
                    if photo not in all_photos:
                        all_photos.append(photo)
            if all_photos:
                media_url = all_photos[0]
            elif m_photos:
                media_url = m_photos[0]
                all_photos = [media_url]

        # 3. Caption / Text bài viết
        caption = ""
        m_txt = re.search(r'<div class="tgme_widget_message_text[^"]*"[^>]*>(.*?)</div>', html, re.DOTALL)
        if m_txt:
            caption = re.sub(r"<[^>]+>", "", m_txt.group(1)).strip()

        # 4. Kênh / Author
        author = channel
        m_auth = re.search(r'<div class="tgme_widget_message_owner_name"[^>]*>(.*?)</div>', html, re.DOTALL)
        if m_auth:
            author = re.sub(r"<[^>]+>", "", m_auth.group(1)).strip() or channel

        if not media_url:
            return None

        title = caption[:70] if caption else f"Telegram @{channel} #{post_id}"
        is_album = len(all_photos) > 1 and media_type == "image"

        return {
            "id": f"{channel}_{post_id}",
            "title": title,
            "uploader": f"Telegram @{author}",
            "media_url": media_url,
            "images": all_photos if media_type == "image" else [],
            "media_type": "album" if is_album else media_type,
            "thumbnail": media_url if media_type == "image" else None,
            "ext": ext,
            "caption": caption,
        }
    except Exception:
        return None


def download_direct_file(
    url: str,
    save_path: str,
    max_bytes: int = MAX_FILESIZE_BYTES,
    headers: Optional[dict] = None,
    on_progress: Optional[callable] = None,
    on_status: Optional[callable] = None,
    pause_event: Optional[threading.Event] = None,
    cancel_event: Optional[threading.Event] = None,
) -> tuple[bool, str]:
    """
    Tải file trực tiếp qua HTTP/HTTPS streaming an toàn:
    - BẢO MẬT: Kiểm tra SSRF, chống DoS bằng kiểm soát max_bytes từng chunk.
    - An toàn đĩa: Ghi vào file .part trước khi atomic move sang file đích.
    - Hỗ trợ Pause / Resume và Cancel ngay lập tức.
    """
    if not is_safe_remote_url(url):
        return False, "URL không an toàn hoặc vi phạm chính sách bảo mật mạng (chống SSRF)."

    default_headers = {
        "User-Agent": (
            "Mozilla/5.0 (X11; Linux x86_64; rv:120.0) "
            "Gecko/20100101 Firefox/120.0"
        ),
        "Accept": "*/*",
    }
    if headers:
        default_headers.update(headers)

    part_path = save_path + ".part"
    downloaded_bytes = 0
    start_time = time.time()

    try:
        req = urllib.request.Request(url, headers=default_headers)
        with urllib.request.urlopen(req, timeout=25) as resp:
            content_len_header = resp.headers.get("Content-Length")
            total_size = int(content_len_header) if content_len_header and content_len_header.isdigit() else 0
            content_type = resp.headers.get("Content-Type", "").lower()
            save_ext = os.path.splitext(save_path)[1].lower().lstrip(".")

            # BẢO MẬT: Ngăn chặn lưu mã nguồn HTML trang web vào tệp media
            if save_ext in SAFE_EXTENSIONS and any(h in content_type for h in ["text/html", "text/plain"]):
                return False, f"Máy chủ trả về trang web HTML ({content_type}) thay vì tệp media hình ảnh/video thực tế. Bài viết có thể bị giới hạn hoặc yêu cầu đăng nhập."

            if total_size > max_bytes:
                return False, f"Dung lượng file ({format_bytes(total_size)}) vượt quá giới hạn an toàn ({format_bytes(max_bytes)})."

            chunk_size = 64 * 1024  # 64 KB
            with open(part_path, "wb") as f_out:
                while True:
                    if cancel_event and cancel_event.is_set():
                        f_out.close()
                        if os.path.exists(part_path):
                            os.remove(part_path)
                        return False, "Người dùng đã hủy tải xuống."

                    if pause_event and not pause_event.is_set():
                        if on_status:
                            on_status("⏸️ Tạm dừng – Nhấn ▶️ Tiếp tục để tiếp tục tải…")
                        pause_event.wait()
                        if cancel_event and cancel_event.is_set():
                            f_out.close()
                            if os.path.exists(part_path):
                                os.remove(part_path)
                            return False, "Người dùng đã hủy tải xuống."
                        if on_status:
                            on_status("▶️ Đã tiếp tục tải…")

                    chunk = resp.read(chunk_size)
                    if not chunk:
                        break

                    # Kiểm tra chunk đầu tiên: ngăn chặn server trả về HTML nhưng Content-Type ẩn danh
                    if downloaded_bytes == 0 and save_ext in SAFE_EXTENSIONS:
                        first_bytes = chunk[:64].lower()
                        if b"<!doctype html" in first_bytes or b"<html" in first_bytes:
                            f_out.close()
                            if os.path.exists(part_path):
                                os.remove(part_path)
                            return False, "Nội dung nhận được từ máy chủ là trang web HTML thay vì dữ liệu media nhị phân. Vui lòng kiểm tra quyền riêng tư của liên kết."

                    f_out.write(chunk)
                    downloaded_bytes += len(chunk)

                    if downloaded_bytes > max_bytes:
                        f_out.close()
                        if os.path.exists(part_path):
                            os.remove(part_path)
                        return False, f"Dung lượng tải về vượt quá giới hạn an toàn ({format_bytes(max_bytes)})."

                    # Báo tiến trình
                    if total_size > 0 and on_progress:
                        pct = (downloaded_bytes / total_size) * 100
                        on_progress(pct)
                    elapsed = max(time.time() - start_time, 0.1)
                    speed = downloaded_bytes / elapsed
                    speed_str = f" – {speed / 1024:.0f} KB/s" if speed > 0 else ""
                    if on_status:
                        if total_size > 0:
                            on_status(f"Đang tải: {(downloaded_bytes / total_size) * 100:.1f}%{speed_str}")
                        else:
                            on_status(f"Đang tải: {downloaded_bytes / 1024:.0f} KB{speed_str}")

        # Hoàn tất: di chuyển từ .part sang file chính thức
        if os.path.exists(save_path):
            os.remove(save_path)
        shutil.move(part_path, save_path)
        harden_file_permissions(save_path)
        if on_progress:
            on_progress(100.0)
        return True, save_path

    except Exception as exc:
        if os.path.exists(part_path):
            try:
                os.remove(part_path)
            except OSError:
                pass
        return False, f"Lỗi tải trực tiếp: {exc}"


def resolve_facebook_photo(
    url: str,
    cookie_browser: Optional[str] = None,
    cookie_file: Optional[str] = None,
) -> Optional[dict]:
    """
    Trích xuất liên kết hình ảnh gốc chất lượng cao từ trang Facebook Photo:
    Hỗ trợ các link dạng:
    - https://www.facebook.com/photo/?fbid=122309558474022335&set=...
    - https://www.facebook.com/photo.php?fbid=...
    - https://www.facebook.com/photo?fbid=...
    - https://www.facebook.com/<user>/photos/...
    Bóc tách mã nguồn trang và giải mã URL CDN thực tế (fbcdn.net) chất lượng cao nhất.
    """
    if not is_safe_remote_url(url):
        return None

    m_fbid = re.search(r"[?&]fbid=(\d+)", url) or re.search(r"/photos/[^/]+/(\d+)", url) or re.search(r"/photos/(\d+)", url)
    fbid = m_fbid.group(1) if m_fbid else hashlib.md5(url.encode()).hexdigest()[:10]

    headers = {
        "User-Agent": (
            "Mozilla/5.0 (X11; Linux x86_64; rv:120.0) "
            "Gecko/20100101 Firefox/120.0"
        ),
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,*/*;q=0.8",
        "Accept-Language": "vi,en-US;q=0.9,en;q=0.8",
        "Sec-Fetch-Dest": "document",
        "Sec-Fetch-Mode": "navigate",
        "Sec-Fetch-Site": "none",
    }

    # Nạp cookies nếu người dùng chỉ định
    if cookie_file and Path(cookie_file).is_file():
        try:
            cookie_pairs = []
            with open(cookie_file, "r", encoding="utf-8", errors="ignore") as cf:
                for line in cf:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    parts = line.split("\t")
                    if len(parts) >= 7:
                        cookie_pairs.append(f"{parts[5]}={parts[6]}")
            if cookie_pairs:
                headers["Cookie"] = "; ".join(cookie_pairs)
        except Exception:
            pass

    try:
        req = urllib.request.Request(url, headers=headers)
        with urllib.request.urlopen(req, timeout=15) as resp:
            raw_html = resp.read().decode("utf-8", errors="ignore")

        clean_text = raw_html.replace(r"\/", "/").replace("&amp;", "&")

        # Trích xuất caption / description
        caption = ""
        m_og_desc = re.search(r'<meta\s+property=["\']og:description["\']\s+content=["\']([^"\']+)["\']', clean_text)
        if m_og_desc:
            caption = html.unescape(m_og_desc.group(1)).strip()
        if not caption:
            m_title = re.search(r"<title>([^<]+)</title>", clean_text)
            if m_title:
                t = html.unescape(m_title.group(1)).strip()
                caption = t.split("|")[0].strip()

        # Tìm các link ảnh từ fbcdn.net
        matches = re.findall(r'https?://[a-zA-Z0-9.-]*fbcdn\.net/[^\s"\'\\<>]+', clean_text)

        album_photos: list[str] = []
        seen_paths: set[str] = set()
        for m in matches:
            u = html.unescape(m).rstrip("\\")
            if any(bad in u for bad in ["t1.30497-1", "p50x50", "p100x100", "s100x100", "profile", "emoji"]):
                continue
            if any(k in u for k in ["t39.30808-6", "t1.6435-9", "t31.180-8", "_n.jpg", "_o.jpg", "dst-jpg"]):
                path_part = u.split("?")[0]
                if path_part not in seen_paths:
                    seen_paths.add(path_part)
                    album_photos.append(u)

        best_candidate = None
        fbid_prefix = fbid[:8] if len(fbid) >= 8 else fbid

        # Ưu tiên 1: Chứa tiền tố fbid và nằm trong thư mục độ phân giải cao t39.30808-6
        for u in album_photos:
            if "t39.30808-6" in u and (fbid_prefix in u):
                best_candidate = u
                break

        # Ưu tiên 2: Nằm trong thư mục t39.30808-6 và có đuôi ảnh tiêu chuẩn _n.jpg/_o.jpg
        if not best_candidate:
            for u in album_photos:
                if "t39.30808-6" in u and ("_n.jpg" in u or "_o.jpg" in u or "dst-jpg" in u):
                    best_candidate = u
                    break

        # Ưu tiên 3: Các kích thước lớn khác (t1.6435-9, t31.180-8, _n.jpg, _o.jpg)
        if not best_candidate and album_photos:
            best_candidate = album_photos[0]

        # Ưu tiên 4: Bất kỳ link ảnh fbcdn nào không phải avatar nhỏ
        if not best_candidate and matches:
            for m in matches:
                u = html.unescape(m).rstrip("\\")
                if not any(bad in u for bad in ["t1.30497-1", "p50x50", "p100x100", "s100x100"]):
                    best_candidate = u
                    if best_candidate not in album_photos:
                        album_photos.append(best_candidate)
                    break

        if not best_candidate:
            return None

        # Đưa best_candidate lên vị trí đầu tiên của album_photos
        if best_candidate in album_photos:
            album_photos.remove(best_candidate)
        album_photos.insert(0, best_candidate)

        title = caption[:80] if caption else f"Facebook Photo #{fbid}"
        is_album = len(album_photos) > 1
        return {
            "id": fbid,
            "title": title,
            "uploader": "Facebook Photo",
            "media_url": best_candidate,
            "images": album_photos,
            "media_type": "album" if is_album else "image",
            "thumbnail": best_candidate,
            "ext": "jpg",
            "fbid": fbid,
        }
    except Exception:
        return None


def lossless_strip_jpeg_metadata(data: bytes) -> bytes:
    """Loại bỏ siêu dữ liệu nhạy cảm EXIF / XMP / IPTC khỏi tệp JPEG mà không decode/re-encode (giữ nguyên 100% DCT pixel)."""
    if not data.startswith(b"\xff\xd8"):
        return data
    out = bytearray(b"\xff\xd8")
    pos = 2
    l = len(data)
    while pos < l:
        if data[pos] != 0xFF:
            out.extend(data[pos:])
            break
        while pos < l and data[pos] == 0xFF:
            pos += 1
        if pos >= l:
            break
        marker = data[pos]
        pos += 1
        if marker in (0xD8, 0xD9, 0x00) or (0xD0 <= marker <= 0xD7):
            out.extend(bytes([0xFF, marker]))
            continue
        if pos + 2 > l:
            break
        length = (data[pos] << 8) | data[pos + 1]
        chunk = data[pos - 2 : pos + length]
        if marker in (0xE1, 0xED):
            pass
        else:
            out.extend(chunk)
        pos += length
    return bytes(out)


def lossless_strip_png_metadata(data: bytes) -> bytes:
    """Loại bỏ chunk metadata (eXIf, tEXt, zTXt, iTXt) khỏi tệp PNG mà không giải nén/nén lại IDAT."""
    png_sig = b"\x89PNG\r\n\x1a\n"
    if not data.startswith(png_sig):
        return data
    out = bytearray(png_sig)
    pos = 8
    l = len(data)
    skip_types = {b"eXIf", b"tEXt", b"zTXt", b"iTXt"}
    while pos + 8 <= l:
        length = struct.unpack(">I", data[pos : pos + 4])[0]
        chunk_type = data[pos + 4 : pos + 8]
        chunk_total = 12 + length
        if pos + chunk_total > l:
            out.extend(data[pos:])
            break
        if chunk_type not in skip_types:
            out.extend(data[pos : pos + chunk_total])
        pos += chunk_total
    return bytes(out)


def lossless_strip_webp_metadata(data: bytes) -> bytes:
    """Loại bỏ EXIF/XMP khỏi container WebP RIFF mà không chạm vào bitstream VP8/VP8L."""
    if not (data.startswith(b"RIFF") and len(data) >= 12 and data[8:12] == b"WEBP"):
        return data
    pos = 12
    l = len(data)
    out_chunks = bytearray()
    skip_chunks = {b"EXIF", b"XMP "}
    has_stripped = False

    while pos + 8 <= l:
        fourcc = data[pos : pos + 4]
        size = struct.unpack("<I", data[pos + 4 : pos + 8])[0]
        pad = size % 2
        chunk_len = 8 + size + pad
        if pos + chunk_len > l:
            out_chunks.extend(data[pos:])
            break
        if fourcc in skip_chunks:
            has_stripped = True
        elif fourcc == b"VP8X" and size >= 10:
            flags = data[pos + 8]
            flags = flags & ~0x08
            flags = flags & ~0x04
            vp8x_chunk = bytearray(data[pos : pos + chunk_len])
            vp8x_chunk[8] = flags
            out_chunks.extend(vp8x_chunk)
        else:
            out_chunks.extend(data[pos : pos + chunk_len])
        pos += chunk_len

    if not has_stripped:
        return data

    new_riff_size = 4 + len(out_chunks)
    out = bytearray(b"RIFF")
    out.extend(struct.pack("<I", new_riff_size))
    out.extend(b"WEBP")
    out.extend(out_chunks)
    return bytes(out)


def lossless_strip_image_file_metadata(file_path: str) -> bool:
    """Thực hiện xóa siêu dữ liệu an toàn losslessly trực tiếp trên file đĩa."""
    try:
        with open(file_path, "rb") as f_in:
            data = f_in.read()
        ext = os.path.splitext(file_path)[1].lower()
        if ext in (".jpg", ".jpeg"):
            cleaned = lossless_strip_jpeg_metadata(data)
        elif ext == ".png":
            cleaned = lossless_strip_png_metadata(data)
        elif ext == ".webp":
            cleaned = lossless_strip_webp_metadata(data)
        else:
            return True

        if cleaned and len(cleaned) > 0 and len(cleaned) != len(data):
            tmp_p = file_path + ".tmp_clean"
            with open(tmp_p, "wb") as f_out:
                f_out.write(cleaned)
            shutil.move(tmp_p, file_path)
            harden_file_permissions(file_path)
        return True
    except Exception:
        return False



def restore_image_color_and_sharpness(
    im: Image.Image,
    apply_hd_sharpness: bool = True,
    apply_srgb_convert: bool = True,
) -> Image.Image:
    """
    Module Xử lý & Khôi phục Màu sắc (Color & Contrast Restoration Engine):
    - Tự động convert không gian màu RGBA/CMYK sang sRGB chuẩn bảo toàn màu để ảnh không bị bợt màu trên màn hình Linux.
    - Sử dụng PIL.ImageOps.autocontrast và bộ lọc làm nét nhẹ ImageFilter.UnsharpMask(radius=1.5, percent=120, threshold=3)
      khi người dùng chọn tùy chọn 'Tối ưu hóa ảnh (HD Sharpness)'.
    - Bảo toàn ICC profile và màu sắc nguyên bản.
    """
    if not HAS_PIL or im is None:
        return im

    result = im

    # 1. Chuẩn hóa không gian màu sang sRGB chuẩn bảo toàn màu (chống bợt màu trên Linux/X11/Wayland)
    if apply_srgb_convert:
        if result.mode == "CMYK":
            try:
                if HAS_PIL and hasattr(ImageCms, "createProfile"):
                    icc_bytes = result.info.get("icc_profile")
                    if icc_bytes:
                        src_profile = ImageCms.getOpenProfile(io.BytesIO(icc_bytes))
                    else:
                        src_profile = ImageCms.createProfile("sRGB")
                    dst_profile = ImageCms.createProfile("sRGB")
                    result = ImageCms.profileToProfile(result, src_profile, dst_profile, outputMode="RGB")
                else:
                    result = result.convert("RGB")
            except Exception:
                result = result.convert("RGB")
        elif result.mode in ("P", "LA"):
            if "transparency" in result.info or result.mode == "LA":
                result = result.convert("RGBA")
            else:
                result = result.convert("RGB")

    # 2. Áp dụng Autocontrast và UnsharpMask nhẹ (HD Sharpness)
    if apply_hd_sharpness:
        try:
            if result.mode == "RGBA":
                r, g, b, a = result.split()
                rgb = Image.merge("RGB", (r, g, b))
                rgb = ImageOps.autocontrast(rgb, cutoff=0.5)
                rgb = rgb.filter(ImageFilter.UnsharpMask(radius=1.5, percent=120, threshold=3))
                r2, g2, b2 = rgb.split()
                result = Image.merge("RGBA", (r2, g2, b2, a))
            elif result.mode == "RGB":
                result = ImageOps.autocontrast(result, cutoff=0.5)
                result = result.filter(ImageFilter.UnsharpMask(radius=1.5, percent=120, threshold=3))
            elif result.mode == "L":
                result = ImageOps.autocontrast(result, cutoff=0.5)
                result = result.filter(ImageFilter.UnsharpMask(radius=1.5, percent=120, threshold=3))
        except Exception:
            pass

    return result


def detect_ai_upscale_engine() -> tuple[str, Optional[str]]:
    """
    Phát hiện engine AI Super-Resolution khả dụng trong hệ thống Linux:
    1. realesrgan-ncnn-vulkan (CLI native Linux x86_64 / GPU Vulkan)
    2. onnxruntime (Neural Network ONNX Engine)
    3. Fallback: High-Fidelity Lanczos Resampling kết hợp Unsharp Masking 4K
    Trả về tuple: (engine_type, path_or_info)
    """
    candidates = [
        os.path.expanduser("~/.local/share/media-downloader/bin/realesrgan-ncnn-vulkan"),
        os.path.expanduser("~/.local/bin/realesrgan-ncnn-vulkan"),
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "bin", "realesrgan-ncnn-vulkan"),
        shutil.which("realesrgan-ncnn-vulkan"),
        shutil.which("realesrgan"),
        "/usr/local/bin/realesrgan-ncnn-vulkan",
        "/usr/bin/realesrgan-ncnn-vulkan",
        "/opt/realesrgan/realesrgan-ncnn-vulkan",
    ]
    for p in candidates:
        if p and os.path.isfile(p) and os.access(p, os.X_OK):
            return "realesrgan-ncnn-vulkan", p

    try:
        import onnxruntime  # noqa: F401
        return "onnxruntime", None
    except ImportError:
        pass

    return "lanczos_fallback", None


REALESRGAN_RELEASE_URL = (
    "https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.5.0/"
    "realesrgan-ncnn-vulkan-20220424-ubuntu.zip"
)


def install_realesrgan_engine(
    on_status: Optional[callable] = None,
    on_progress: Optional[callable] = None,
) -> tuple[bool, str]:
    """
    Tải và cài đặt tự động (1-Click) Real-ESRGAN Vulkan GPU Native Engine cho Linux x86_64:
    - Điểm đến: ~/.local/share/media-downloader/bin/
    - Tải file zip chính thức từ GitHub releases
    - Giải nén an toàn (chống Zip Slip)
    - Phân quyền thực thi 0755
    - Tự động liên kết mềm vào ~/.local/bin nếu thư mục tồn tại
    - Kiểm tra thực thi (Verification run)
    """
    install_dir = os.path.expanduser("~/.local/share/media-downloader/bin")
    os.makedirs(install_dir, exist_ok=True)

    bin_path = os.path.join(install_dir, "realesrgan-ncnn-vulkan")
    zip_part = os.path.join(install_dir, "realesrgan_download.zip.part")
    zip_final = os.path.join(install_dir, "realesrgan_download.zip")

    if on_status:
        on_status("🌐 Đang kết nối tải Real-ESRGAN Vulkan GPU Release…")

    headers = {
        "User-Agent": (
            "Mozilla/5.0 (X11; Linux x86_64; rv:120.0) "
            "Gecko/20100101 Firefox/120.0"
        ),
        "Accept": "*/*",
    }

    try:
        req = urllib.request.Request(REALESRGAN_RELEASE_URL, headers=headers)
        with urllib.request.urlopen(req, timeout=30) as resp:
            total_size = int(resp.headers.get("Content-Length") or 0)
            downloaded = 0
            chunk_size = 64 * 1024

            with open(zip_part, "wb") as f_out:
                while True:
                    chunk = resp.read(chunk_size)
                    if not chunk:
                        break
                    f_out.write(chunk)
                    downloaded += len(chunk)
                    if total_size > 0 and on_progress:
                        pct = min(100, int((downloaded / total_size) * 100))
                        on_progress(pct)
                    if on_status and total_size > 0:
                        on_status(f"📥 Đang tải Real-ESRGAN GPU ({format_bytes(downloaded)} / {format_bytes(total_size)})…")

        if os.path.exists(zip_final):
            os.remove(zip_final)
        os.rename(zip_part, zip_final)

        if on_status:
            on_status("📦 Đang giải nén mô hình và binary AI GPU Engine…")

        import zipfile
        with zipfile.ZipFile(zip_final, "r") as zf:
            for member in zf.infolist():
                # Chống Zip Slip / Path Traversal
                target_path = os.path.abspath(os.path.join(install_dir, member.filename))
                if not target_path.startswith(os.path.abspath(install_dir)):
                    continue
                zf.extract(member, install_dir)

        # Xóa file zip tạm
        if os.path.exists(zip_final):
            try:
                os.remove(zip_final)
            except OSError:
                pass

        if not os.path.isfile(bin_path):
            return False, f"Không tìm thấy tệp thực thi sau giải nén: {bin_path}"

        # Cấp quyền thực thi
        os.chmod(bin_path, 0o755)

        # Tạo symlink vào ~/.local/bin nếu có
        local_bin_dir = os.path.expanduser("~/.local/bin")
        if os.path.isdir(local_bin_dir):
            symlink_path = os.path.join(local_bin_dir, "realesrgan-ncnn-vulkan")
            try:
                if os.path.islink(symlink_path) or os.path.exists(symlink_path):
                    os.remove(symlink_path)
                os.symlink(bin_path, symlink_path)
            except Exception:
                pass

        # Kiểm tra chạy thử nghiệm engine
        if on_status:
            on_status("🧪 Đang kiểm tra tương thích Vulkan GPU…")

        res = subprocess.run([bin_path, "-h"], stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=5)
        help_output = (res.stdout + res.stderr).decode("utf-8", errors="ignore")
        if "realesrgan-ncnn-vulkan" in help_output or "Usage" in help_output or res.returncode in (0, 255):
            return True, f"Cài đặt thành công Real-ESRGAN Vulkan GPU Engine tại: {bin_path}"
        else:
            return True, f"Đã cài đặt Real-ESRGAN tại {bin_path}. Kiểm tra Vulkan trả về mã {res.returncode}."

    except Exception as e:
        if os.path.exists(zip_part):
            try:
                os.remove(zip_part)
            except OSError:
                pass
        return False, f"Lỗi trong quá trình tải / cài đặt: {e}"


def run_ai_super_resolution(
    source_path: str,
    target_path: str,
    scale: int = 2,
    target_max_dim: int = 3840,
    on_status: Optional[callable] = None,
) -> tuple[bool, str]:
    """
    Thực thi AI Super-Resolution:
    - Nếu có realesrgan-ncnn-vulkan: gọi engine native GPU để upscale x2/x4 chi tiết vượt trội.
    - Nếu không có: tự động fallback sang High-Fidelity Lanczos Resampling 2K/4K kết hợp UnsharpMask
      và phục hồi màu sắc sRGB.
    Trả về (success, target_path_or_err).
    """
    if not HAS_PIL:
        return False, "Cần thư viện Pillow để xử lý ảnh."

    if not os.path.isfile(source_path):
        return False, f"Tệp nguồn không tồn tại: {source_path}"

    engine_type, engine_bin = detect_ai_upscale_engine()
    scale = max(2, min(4, scale))

    # 1. Nếu có realesrgan-ncnn-vulkan binary
    if engine_type == "realesrgan-ncnn-vulkan" and engine_bin:
        if on_status:
            on_status(f"🚀 Đang chạy Real-ESRGAN Vulkan GPU (x{scale} Detail)…")
        model_name = "realesrgan-x4plus" if scale >= 4 else "realesrnet-x4plus"
        tmp_ai = target_path + ".ai_gpu.png"
        models_dir = os.path.join(os.path.dirname(engine_bin), "models")
        cmd = [
            engine_bin,
            "-i", source_path,
            "-o", tmp_ai,
            "-s", str(scale),
            "-n", model_name,
        ]
        if os.path.isdir(models_dir):
            cmd.extend(["-m", models_dir])
        try:
            res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=120)
            if res.returncode == 0 and os.path.isfile(tmp_ai) and os.path.getsize(tmp_ai) > 0:
                if os.path.exists(target_path):
                    os.remove(target_path)
                shutil.move(tmp_ai, target_path)
                harden_file_permissions(target_path)
                return True, target_path
        except Exception:
            pass
        finally:
            if os.path.exists(tmp_ai):
                try:
                    os.remove(tmp_ai)
                except OSError:
                    pass

    # 2. Fallback: High-Fidelity Lanczos Resampling kết hợp phục hồi màu sắc & chi tiết
    if on_status:
        on_status(f"⚡ Đang áp dụng High-Definition Super-Resolution x{scale}…")
    try:
        tmp_lanczos = target_path + ".ai_lanczos"
        with Image.open(source_path) as im:
            icc_prof = im.info.get("icc_profile")
            w, h = im.size
            new_w, new_h = w * scale, h * scale

            # Giới hạn kích thước theo target_max_dim (chuẩn 2K/4K)
            if target_max_dim and (new_w > target_max_dim or new_h > target_max_dim):
                ratio = min(target_max_dim / new_w, target_max_dim / new_h)
                new_w = max(1, int(new_w * ratio))
                new_h = max(1, int(new_h * ratio))

            im_up = im.resize((new_w, new_h), Image.Resampling.LANCZOS)
            # Khôi phục màu sắc và làm nét tương phản HD
            im_up = restore_image_color_and_sharpness(
                im_up,
                apply_hd_sharpness=True,
                apply_srgb_convert=True,
            )

            out_ext = os.path.splitext(target_path)[1].lower()
            save_kw: dict = {}
            if icc_prof:
                save_kw["icc_profile"] = icc_prof

            if out_ext in (".jpg", ".jpeg"):
                if im_up.mode != "RGB":
                    if im_up.mode in ("RGBA", "LA") or (im_up.mode == "P" and "transparency" in im_up.info):
                        bg = Image.new("RGB", im_up.size, (255, 255, 255))
                        bg.paste(im_up, mask=im_up.split()[-1])
                        im_up = bg
                    else:
                        im_up = im_up.convert("RGB")
                save_kw["quality"] = 98
                save_kw["subsampling"] = 0
                save_kw["keep_rgb"] = True
                save_kw["optimize"] = True
                im_up.save(tmp_lanczos, format="JPEG", **save_kw)
            elif out_ext == ".webp":
                save_kw["quality"] = 98
                save_kw["method"] = 6
                im_up.save(tmp_lanczos, format="WEBP", **save_kw)
            elif out_ext == ".png":
                save_kw["optimize"] = True
                im_up.save(tmp_lanczos, format="PNG", **save_kw)
            else:
                im_up.save(tmp_lanczos, **save_kw)

        if os.path.exists(target_path):
            os.remove(target_path)
        shutil.move(tmp_lanczos, target_path)
        harden_file_permissions(target_path)
        return True, target_path
    except Exception as exc:
        if os.path.exists(tmp_lanczos):
            try:
                os.remove(tmp_lanczos)
            except OSError:
                pass
        return False, f"Lỗi Super-Resolution: {exc}"


def process_downloaded_image(
    source_path: str,
    transcode_format: str = "Gốc (Giữ nguyên định dạng gốc)",
    resolution_mode: str = "Gốc / Master (Original 100%)",
    compress_quality: str = "100% (Gốc / Bit-Exact 99-100% - Khuyến nghị)",
    strip_exif: bool = True,
    optimize_palette: bool = True,
    frame_grabber: str = "Tắt (Giữ nguyên toàn bộ tệp)",
    create_thumb: bool = False,
    hd_sharpness: bool = False,
    ai_upscale: bool = False,
    on_status: Optional[callable] = None,
) -> tuple[bool, str, list[str]]:
    """
    Xử lý hậu kỳ hình ảnh an toàn và chuyên sâu qua thư viện Pillow (PIL):
    - Format Transcoding: Chuyển đổi định dạng (.png, .jpg, .webp, .gif, .bmp, .ico, .tiff).
    - Original/Master Resolution: Giữ nguyên, phóng to 2x/4x (Super-Res), thu nhỏ 50%, hoặc chuẩn 4K/2K/FHD/HD.
    - Image Compression: Mức nén chất lượng (100% Lossless, 92%, 85%, 75%, 60%).
    - Frame Grabber / Snapshot: Trích xuất Frame đầu tiên (Poster Snapshot) hoặc bóc tách toàn bộ frame (Burst Extract).
    - Privacy Clean: Loại bỏ siêu dữ liệu EXIF/GPS nhưng BẢO TOÀN ICC COLOR PROFILE nguyên gốc.
    - Color & Contrast Restoration: Tự động convert RGBA/CMYK sang sRGB chuẩn bảo toàn màu, áp dụng autocontrast và unsharp mask nhẹ.
    - AI Super-Resolution: Tự động upscale x2/x4 detail (GPU Vulkan / High-Fidelity Lanczos).
    - Web Palette Optimize: Tối ưu hóa bảng màu giảm dung lượng.
    - Thumbnail: Tự động sinh file thumbnail ảnh thu nhỏ (.thumb.jpg).
    """
    if not HAS_PIL:
        return True, source_path, []

    if not os.path.isfile(source_path):
        return False, "Tệp nguồn không tồn tại.", []

    extra_artifacts: list[str] = []
    src_dir = os.path.dirname(source_path)
    src_filename = os.path.basename(source_path)
    base_name, orig_ext = os.path.splitext(src_filename)
    orig_ext = orig_ext.lower()

    try:
        im = Image.open(source_path)
    except Exception as exc:
        if orig_ext == ".svg":
            return True, source_path, []
        try:
            with open(source_path, "rb") as f_chk:
                hdr = f_chk.read(512).lower()
            if b"<!doctype html" in hdr or b"<html" in hdr:
                return False, "Tệp tải về không phải ảnh hợp lệ (chứa mã nguồn HTML trang web). Có thể bài viết bị giới hạn quyền riêng tư hoặc cần đăng nhập.", []
        except Exception:
            pass
        return False, f"Không thể mở tệp hình ảnh qua Pillow (File bị lỗi hoặc định dạng không hỗ trợ): {exc}", []

    orig_w, orig_h = im.size
    is_animated = bool(getattr(im, "is_animated", False) and getattr(im, "n_frames", 1) > 1)

    # 1. Frame Grabber / Snapshot
    is_burst = "bóc tách toàn bộ" in frame_grabber.lower() or "burst" in frame_grabber.lower()
    is_poster = "frame đầu tiên" in frame_grabber.lower() or "poster" in frame_grabber.lower()

    if is_burst and is_animated:
        if on_status:
            on_status("📸 Đang bóc tách từng khung hình (Burst Extraction)…")
        burst_dir = os.path.join(src_dir, f"{base_name}_frames")
        os.makedirs(burst_dir, exist_ok=True)
        for idx, fr in enumerate(ImageSequence.Iterator(im)):
            fr_copy = fr.copy()
            if fr_copy.mode in ("P", "RGBA", "LA"):
                fr_copy = fr_copy.convert("RGBA")
            else:
                fr_copy = fr_copy.convert("RGB")
            fr_path = os.path.join(burst_dir, f"frame_{idx+1:04d}.png")
            fr_copy.save(fr_path, format="PNG", optimize=optimize_palette)
            harden_file_permissions(fr_path)
            extra_artifacts.append(fr_path)

    if is_poster and is_animated:
        im.seek(0)
        im = im.copy()
        is_animated = False

    # 2. Quality parsing
    q_match = re.search(r"(\d+)", compress_quality)
    quality = int(q_match.group(1)) if q_match else 100
    quality = max(1, min(100, quality))

    # 3. Transcode Format
    fmt_str = transcode_format.upper()
    if "PNG" in fmt_str:
        out_fmt = "PNG"
        out_ext = ".png"
    elif "JPEG" in fmt_str or "JPG" in fmt_str:
        out_fmt = "JPEG"
        out_ext = ".jpg"
    elif "WEBP" in fmt_str:
        out_fmt = "WEBP"
        out_ext = ".webp"
    elif "GIF" in fmt_str:
        out_fmt = "GIF"
        out_ext = ".gif"
    elif "BMP" in fmt_str:
        out_fmt = "BMP"
        out_ext = ".bmp"
    elif "ICO" in fmt_str:
        out_fmt = "ICO"
        out_ext = ".ico"
    elif "TIFF" in fmt_str:
        out_fmt = "TIFF"
        out_ext = ".tiff"
    else:
        out_fmt = (im.format or "PNG").upper()
        out_ext = orig_ext if orig_ext else f".{out_fmt.lower()}"

    # 4. Target Resolution (Scale / Fit)
    res_lower = resolution_mode.lower()
    apply_hd_sharpness = bool(hd_sharpness or "hd sharpness" in res_lower or "tối ưu hóa ảnh" in res_lower)
    apply_ai_upscale = bool(ai_upscale or "ai super-resolution" in res_lower)

    new_w, new_h = orig_w, orig_h
    if "2x" in res_lower and not apply_ai_upscale:
        new_w, new_h = orig_w * 2, orig_h * 2
    elif "50%" in res_lower:
        new_w, new_h = max(1, orig_w // 2), max(1, orig_h // 2)
    elif "4k" in res_lower and not apply_ai_upscale:
        box = (3840, 2160)
        if orig_w > box[0] or orig_h > box[1]:
            r = min(box[0] / orig_w, box[1] / orig_h)
            new_w, new_h = max(1, int(orig_w * r)), max(1, int(orig_h * r))
    elif "2k" in res_lower and not apply_ai_upscale:
        box = (2560, 1440)
        if orig_w > box[0] or orig_h > box[1]:
            r = min(box[0] / orig_w, box[1] / orig_h)
            new_w, new_h = max(1, int(orig_w * r)), max(1, int(orig_h * r))
    elif "full hd" in res_lower:
        box = (1920, 1080)
        if orig_w > box[0] or orig_h > box[1]:
            r = min(box[0] / orig_w, box[1] / orig_h)
            new_w, new_h = max(1, int(orig_w * r)), max(1, int(orig_h * r))
    elif "chuẩn hd" in res_lower:
        box = (1280, 720)
        if orig_w > box[0] or orig_h > box[1]:
            r = min(box[0] / orig_w, box[1] / orig_h)
            new_w, new_h = max(1, int(orig_w * r)), max(1, int(orig_h * r))
    elif "avatar" in res_lower:
        box = (512, 512)
        r = min(box[0] / orig_w, box[1] / orig_h)
        new_w, new_h = max(1, int(orig_w * r)), max(1, int(orig_h * r))
    elif "banner" in res_lower:
        box = (1200, 630)
        r = min(box[0] / orig_w, box[1] / orig_h)
        new_w, new_h = max(1, int(orig_w * r)), max(1, int(orig_h * r))

    resize_needed = (new_w, new_h) != (orig_w, orig_h)

    # 5. Bit-Exact Master Pass-Through Mode (Đạt chuẩn 99-100% chất lượng gốc)
    format_unchanged = ("GỐC" in transcode_format.upper()) or (out_ext.lower() == orig_ext.lower())
    is_passthrough = (
        format_unchanged
        and not resize_needed
        and quality == 100
        and not is_poster
        and not is_burst
        and not apply_hd_sharpness
        and not apply_ai_upscale
    )

    if is_passthrough:
        if on_status:
            on_status("🛡️ Áp dụng chế độ Bit-Exact Master 100% (Bảo toàn tuyệt đối độ sắc nét gốc)…")
        if strip_exif:
            lossless_strip_image_file_metadata(source_path)

        if create_thumb:
            thumb_path = os.path.join(src_dir, f"{base_name}.thumb.jpg")
            im_th = im.copy()
            if im_th.mode in ("RGBA", "LA") or (im_th.mode == "P" and "transparency" in im_th.info):
                bg = Image.new("RGB", im_th.size, (255, 255, 255))
                bg.paste(im_th, mask=im_th.split()[-1])
                im_th = bg
            elif im_th.mode != "RGB":
                im_th = im_th.convert("RGB")
            im_th.thumbnail((320, 320), Image.Resampling.LANCZOS)
            im_th.save(thumb_path, "JPEG", quality=90, subsampling=0, optimize=True)
            harden_file_permissions(thumb_path)
            extra_artifacts.append(thumb_path)

        return True, source_path, extra_artifacts

    # 6. Process and Re-encode khi người dùng yêu cầu biến đổi định dạng, kích thước, khôi phục màu hoặc upscale
    if is_poster:
        dest_filename = f"{base_name}_poster{out_ext}"
    elif out_ext != orig_ext or resize_needed or quality != 100 or is_burst or apply_ai_upscale or apply_hd_sharpness:
        dest_filename = f"{base_name}{out_ext}"
    else:
        dest_filename = src_filename

    target_path = os.path.join(src_dir, dest_filename)
    tmp_out = target_path + ".tmp_proc"

    try:
        # Xóa EXIF / Metadata nhạy cảm nếu được yêu cầu nhưng BẢO TOÀN ICC COLOR PROFILE
        icc_profile = im.info.get("icc_profile")
        if strip_exif:
            im.info.pop("exif", None)
            # Không xóa icc_profile: bảo toàn màu sắc chính xác trên Linux

        if is_animated and out_fmt in ("GIF", "WEBP") and not is_poster:
            frames_out = []
            for fr in ImageSequence.Iterator(im):
                f = fr.copy()
                if resize_needed:
                    f = f.resize((new_w, new_h), Image.Resampling.LANCZOS)
                if out_fmt == "WEBP" and f.mode not in ("RGB", "RGBA"):
                    f = f.convert("RGBA")
                frames_out.append(f)

            save_kw = {
                "save_all": True,
                "append_images": frames_out[1:],
                "duration": im.info.get("duration", 100),
                "loop": im.info.get("loop", 0),
            }
            if icc_profile:
                save_kw["icc_profile"] = icc_profile
            if out_fmt == "WEBP":
                if quality == 100:
                    save_kw["lossless"] = True
                else:
                    save_kw["quality"] = quality
                save_kw["method"] = 6
            frames_out[0].save(tmp_out, format=out_fmt, **save_kw)
        else:
            if resize_needed:
                im = im.resize((new_w, new_h), Image.Resampling.LANCZOS)
                if "2x" in res_lower and not apply_hd_sharpness:
                    im = im.filter(ImageFilter.UnsharpMask(radius=1.0, percent=35, threshold=2))

            # Chuẩn hóa không gian màu và tối ưu hóa nét (HD Sharpness & sRGB Color Restoration)
            im = restore_image_color_and_sharpness(
                im,
                apply_hd_sharpness=apply_hd_sharpness,
                apply_srgb_convert=True,
            )

            # Chuyển đổi Color Mode tương thích theo định dạng đích
            if out_fmt in ("JPEG", "JPG"):
                if im.mode in ("RGBA", "LA") or (im.mode == "P" and "transparency" in im.info):
                    bg = Image.new("RGB", im.size, (255, 255, 255))
                    bg.paste(im, mask=im.split()[-1])
                    im = bg
                elif im.mode != "RGB":
                    im = im.convert("RGB")
            elif out_fmt == "BMP":
                if im.mode not in ("RGB", "L"):
                    im = im.convert("RGB")
            elif out_fmt == "ICO":
                if max(im.size) > 256:
                    im = im.resize((256, 256), Image.Resampling.LANCZOS)
                if im.mode != "RGBA":
                    im = im.convert("RGBA")
            elif out_fmt == "WEBP":
                if im.mode not in ("RGB", "RGBA"):
                    im = im.convert("RGBA")
            elif out_fmt == "PNG":
                if im.mode not in ("RGB", "RGBA", "L", "LA", "P"):
                    im = im.convert("RGBA")

            save_kw = {}
            if icc_profile:
                save_kw["icc_profile"] = icc_profile

            if out_fmt in ("JPEG", "JPG"):
                save_kw["quality"] = quality
                save_kw["subsampling"] = 0  # 4:4:4 full chroma - bảo toàn sắc nét không làm nhòe màu viền và sợi tóc!
                save_kw["optimize"] = optimize_palette
                save_kw["keep_rgb"] = True
            elif out_fmt == "WEBP":
                if quality == 100:
                    save_kw["lossless"] = True
                else:
                    save_kw["quality"] = quality
                save_kw["method"] = 6
            elif out_fmt == "PNG":
                save_kw["optimize"] = optimize_palette
            elif out_fmt == "ICO":
                save_kw["sizes"] = [(16, 16), (32, 32), (48, 48), (64, 64), (128, 128), (256, 256)]

            im.save(tmp_out, format=out_fmt, **save_kw)

        # 7. AI Super-Resolution (x2 / x4 Detail lên chuẩn 2K/4K)
        if apply_ai_upscale and not is_animated:
            target_scale = 4 if ("4k" in res_lower or "x4" in res_lower) else 2
            ai_tmp = tmp_out + ".ai.png"
            ok_ai, ai_path = run_ai_super_resolution(
                source_path=tmp_out,
                target_path=ai_tmp,
                scale=target_scale,
                target_max_dim=3840 if target_scale == 4 else 2560,
                on_status=on_status,
            )
            if ok_ai and os.path.isfile(ai_path):
                if out_fmt != "PNG":
                    with Image.open(ai_path) as im_ai:
                        if out_fmt in ("JPEG", "JPG") and im_ai.mode != "RGB":
                            im_ai = im_ai.convert("RGB")
                        im_ai.save(tmp_out, format=out_fmt, **save_kw)
                    try:
                        os.remove(ai_path)
                    except OSError:
                        pass
                else:
                    if os.path.exists(tmp_out):
                        os.remove(tmp_out)
                    shutil.move(ai_path, tmp_out)

        if os.path.exists(target_path):
            os.remove(target_path)
        shutil.move(tmp_out, target_path)
        harden_file_permissions(target_path)

        if target_path != source_path and os.path.exists(source_path):
            try:
                os.remove(source_path)
            except OSError:
                pass

        # 8. Thumbnail riêng (.thumb.jpg)
        if create_thumb:
            thumb_path = os.path.join(src_dir, f"{base_name}.thumb.jpg")
            im_th = im.copy()
            if im_th.mode in ("RGBA", "LA") or (im_th.mode == "P" and "transparency" in im_th.info):
                bg = Image.new("RGB", im_th.size, (255, 255, 255))
                bg.paste(im_th, mask=im_th.split()[-1])
                im_th = bg
            elif im_th.mode != "RGB":
                im_th = im_th.convert("RGB")
            im_th.thumbnail((320, 320), Image.Resampling.LANCZOS)
            im_th.save(thumb_path, "JPEG", quality=90, subsampling=0, optimize=True)
            harden_file_permissions(thumb_path)
            extra_artifacts.append(thumb_path)

        return True, target_path, extra_artifacts

    except Exception as exc:
        if os.path.exists(tmp_out):
            try:
                os.remove(tmp_out)
            except OSError:
                pass
        return False, f"Lỗi xử lý hình ảnh qua Pillow: {exc}", extra_artifacts


# ═══════════════════════════════════════════════════════════════════════════════
# CORE DOWNLOAD / AUDIT ENGINE
# ═══════════════════════════════════════════════════════════════════════════════

class AuditEngine:
    """Thực thi kiểm thử và tải media an toàn qua yt-dlp Python API."""

    def __init__(
        self,
        url: str,
        save_dir: str,
        target: str,
        media_mode: str,          # "video" | "audio" | "image"
        video_format: str,        # "mp4" | "mkv" | "webm"
        video_resolution: str,    # e.g. "1080", "720", "best", etc.
        audio_codec: str,         # "mp3" | "m4a" | "wav" | "flac" | "opus"
        audio_bitrate: str,       # "320" | "256" | "192" | "128" | "96" | "auto"
        enable_subtitles: bool,   # True / False
        subtitle_lang: str,       # "vi" | "en" | "both" | "orig" | "all"
        embed_subtitles: bool,    # True / False
        enable_thumbnail: bool,   # True / False (lưu file .jpg)
        embed_thumbnail: bool,    # True / False (nhúng vào file media)
        on_status: callable,      # type: ignore[type-arg]
        on_progress: callable,    # type: ignore[type-arg]
        on_finish: callable,      # type: ignore[type-arg]
        cookie_browser: Optional[str] = None,
        cookie_file: Optional[str] = None,
        pause_event: Optional[threading.Event] = None,
        cancel_event: Optional[threading.Event] = None,
        img_transcode: str = "Gốc (Giữ nguyên định dạng gốc)",
        img_res: str = "Gốc / Master (Original 100%)",
        img_compress: str = "92% (Chất lượng rất cao - Khuyến nghị)",
        img_frame_grabber: str = "Tắt (Giữ nguyên toàn bộ tệp)",
        img_strip_exif: bool = True,
        img_palette_opt: bool = True,
        img_create_thumb: bool = False,
        img_hd_sharpness: bool = False,
        img_ai_upscale: bool = False,
        img_download_all: bool = True,
        clip_start: Optional[str] = None,
        clip_end: Optional[str] = None,
    ) -> None:
        self.url = url
        self.save_dir = save_dir
        self.target = target
        self.media_mode = media_mode
        self.video_format = video_format.lower()
        self.video_resolution = video_resolution
        self.audio_codec = audio_codec.lower()
        self.audio_bitrate = audio_bitrate
        self.enable_subtitles = enable_subtitles
        self.subtitle_lang = subtitle_lang
        self.embed_subtitles = embed_subtitles
        self.enable_thumbnail = enable_thumbnail
        self.embed_thumbnail = embed_thumbnail
        self.clip_start = clip_start.strip() if (clip_start and clip_start.strip()) else None
        self.clip_end = clip_end.strip() if (clip_end and clip_end.strip()) else None
        self._on_status = on_status
        self._on_progress = on_progress
        self._on_finish = on_finish
        self.cookie_browser = cookie_browser
        self.cookie_file = cookie_file
        # Cấu hình xử lý hình ảnh qua Pillow
        self.img_transcode = img_transcode
        self.img_res = img_res
        self.img_compress = img_compress
        self.img_frame_grabber = img_frame_grabber
        self.img_strip_exif = img_strip_exif
        self.img_palette_opt = img_palette_opt
        self.img_create_thumb = img_create_thumb
        self.img_hd_sharpness = img_hd_sharpness
        self.img_ai_upscale = img_ai_upscale
        self.img_download_all = img_download_all
        # Pause/Resume: event.is_set() = đang chạy; event.clear() = tạm dừng
        self.pause_event = pause_event or threading.Event()
        if not self.pause_event.is_set():
            self.pause_event.set()  # Mặc định: đang chạy
        # Cancel: event.is_set() = đã hủy
        self.cancel_event = cancel_event or threading.Event()

    def _apply_image_processing(
        self,
        dest_file: str,
        title: str = "",
        extra_info: Optional[dict] = None,
    ) -> None:
        """Thực thi pipeline xử lý ảnh hậu kỳ (Scale, Transcode, Compress, Strip EXIF, HD Sharpness, AI Upscale, Frame Grabber)."""
        extra_info = extra_info or {}
        self._on_status("⚙️ Đang xử lý hậu kỳ hình ảnh (Pillow Pipeline)…")
        ok_proc, final_path, extra_artifacts = process_downloaded_image(
            source_path=dest_file,
            transcode_format=self.img_transcode,
            resolution_mode=self.img_res,
            compress_quality=self.img_compress,
            strip_exif=self.img_strip_exif,
            optimize_palette=self.img_palette_opt,
            frame_grabber=self.img_frame_grabber,
            create_thumb=self.img_create_thumb,
            hd_sharpness=self.img_hd_sharpness,
            ai_upscale=self.img_ai_upscale,
            on_status=self._on_status,
        )
        if not ok_proc:
            self._on_status(STATUS_ERROR)
            self._on_finish(False, f"Lỗi xử lý hình ảnh: {final_path}")
            return

        self._on_status(STATUS_COMPLETED)
        self._on_progress(100)

        # Trích xuất thông tin ảnh cuối cùng
        final_ext = os.path.splitext(final_path)[1].lstrip(".").upper()
        file_sz = os.path.getsize(final_path)
        dim_str = ""
        if HAS_PIL:
            try:
                with Image.open(final_path) as im:
                    dim_str = f"{im.size[0]}x{im.size[1]}"
            except Exception:
                pass

        details = [
            "Tải và xử lý hình ảnh hoàn tất thành công!",
            "",
            f"📌 Tiêu đề: {title or os.path.basename(final_path)}",
            f"🖼️ Định dạng xuất: {final_ext}" + (f" ({dim_str})" if dim_str else ""),
            f"📁 Đã lưu: {final_path}",
            f"💾 Dung lượng: {format_bytes(file_sz)}",
        ]
        if self.img_res and "Gốc" not in self.img_res:
            details.append(f"📐 Chế độ phân giải: {self.img_res}")
        if self.img_compress:
            details.append(f"🗜️ Mức nén: {self.img_compress}")
        if self.img_hd_sharpness or "HD Sharpness" in self.img_res:
            details.append("✨ Tối ưu hóa nét & Màu sắc: Đã áp dụng (HD Sharpness)")
        if self.img_ai_upscale or "AI Super-Resolution" in self.img_res:
            details.append("🚀 AI Super-Resolution: Đã kích hoạt (x2/x4 Detail)")
        if self.img_strip_exif:
            details.append("🛡️ Siêu dữ liệu EXIF/GPS: Đã loại bỏ an toàn (Bảo toàn ICC)")
        if extra_artifacts:
            details.append(f"📦 Tệp phụ kèm theo: {len(extra_artifacts)} tệp")
            for art in extra_artifacts[:5]:
                details.append(f"   • {os.path.basename(art)}")
            if len(extra_artifacts) > 5:
                details.append(f"   ... và {len(extra_artifacts) - 5} tệp khác")

        finish_msg = "\n".join(details)
        self._on_finish(True, finish_msg)

    def _apply_multi_image_download_and_processing(
        self,
        image_urls: list[str],
        base_prefix: str,
        title: str = "",
        extra_info: Optional[dict] = None,
    ) -> None:
        """
        Tải và xử lý hàng loạt toàn bộ ảnh trong một Album / Carousel (Twitter, Telegram, Facebook).
        Hỗ trợ:
        - Tiến trình tổng hợp và từng ảnh chi tiết.
        - Pause / Resume / Cancel an toàn.
        - Pipeline xử lý Pillow (Scale, Transcode, HD Sharpness, AI Upscaling, EXIF strip).
        - Báo cáo hoàn tất tổng hợp.
        """
        extra_info = extra_info or {}
        # Lọc URL trùng lặp nhưng giữ nguyên thứ tự
        unique_urls: list[str] = []
        for u in image_urls:
            if u and u not in unique_urls:
                unique_urls.append(u)

        total = len(unique_urls)
        if total == 0:
            self._on_status(STATUS_ERROR)
            self._on_finish(False, "Không tìm thấy URL hình ảnh hợp lệ trong album.")
            return

        # Nếu chỉ có 1 ảnh hoặc người dùng tắt chế độ tải toàn bộ album: chỉ tải ảnh đầu tiên
        if total == 1 or not self.img_download_all:
            first_url = unique_urls[0]
            ext = "png" if "format=png" in first_url else "jpg"
            dest_file = os.path.join(self.save_dir, f"{base_prefix}.{ext}")
            self._on_status("🖼️ Đang tải hình ảnh…")
            ok, res_path = download_direct_file(
                url=first_url,
                save_path=dest_file,
                max_bytes=MAX_FILESIZE_BYTES,
                on_progress=self._on_progress,
                on_status=self._on_status,
                pause_event=self.pause_event,
                cancel_event=self.cancel_event,
            )
            if not ok:
                self._on_status(STATUS_ERROR)
                self._on_finish(False, res_path)
                return
            self._apply_image_processing(dest_file, title=title, extra_info=extra_info)
            return

        self._on_status(f"📚 Phát hiện Album / Carousel gồm {total} hình ảnh. Bắt đầu tải trọn bộ…")
        processed_files: list[str] = []
        all_artifacts: list[str] = []
        failed_count = 0

        for idx, img_url in enumerate(unique_urls, 1):
            if self.cancel_event.is_set():
                self._on_status("❌ Đã hủy tải Album.")
                self._on_finish(False, "Người dùng đã hủy quá trình tải Album.")
                return

            ext = "png" if "format=png" in img_url else "jpg"
            filename = f"{base_prefix}_{idx:02d}.{ext}"
            dest_file = os.path.join(self.save_dir, filename)

            self._on_status(f"🖼️ [{idx}/{total}] Đang tải ảnh ({idx}/{total})…")

            def _sub_progress(chunk_pct: float, current_idx=idx, total_imgs=total):
                base_pct = ((current_idx - 1) / total_imgs) * 100.0
                curr_img_pct = (chunk_pct / total_imgs)
                overall = min(100, int(base_pct + curr_img_pct))
                self._on_progress(overall)

            ok, res_path = download_direct_file(
                url=img_url,
                save_path=dest_file,
                max_bytes=MAX_FILESIZE_BYTES,
                on_progress=_sub_progress,
                on_status=self._on_status,
                pause_event=self.pause_event,
                cancel_event=self.cancel_event,
            )
            if not ok:
                failed_count += 1
                self._on_status(f"⚠️ Không tải được ảnh {idx}/{total}: {res_path}")
                continue

            # Áp dụng Pipeline xử lý hình ảnh cho từng file
            self._on_status(f"⚙️ [{idx}/{total}] Đang xử lý hậu kỳ ảnh {idx}/{total}…")
            ok_proc, final_path, extra_artifacts = process_downloaded_image(
                source_path=dest_file,
                transcode_format=self.img_transcode,
                resolution_mode=self.img_res,
                compress_quality=self.img_compress,
                strip_exif=self.img_strip_exif,
                optimize_palette=self.img_palette_opt,
                frame_grabber=self.img_frame_grabber,
                create_thumb=self.img_create_thumb,
                hd_sharpness=self.img_hd_sharpness,
                ai_upscale=self.img_ai_upscale,
                on_status=self._on_status,
            )
            if ok_proc:
                processed_files.append(final_path)
                if extra_artifacts:
                    all_artifacts.extend(extra_artifacts)
            else:
                processed_files.append(dest_file)

        if not processed_files:
            self._on_status(STATUS_ERROR)
            self._on_finish(False, "Tất cả các ảnh trong album đều tải thất bại.")
            return

        self._on_status(STATUS_COMPLETED)
        self._on_progress(100)

        details = [
            f"🎉 Tải trọn bộ Album ({len(processed_files)}/{total} ảnh) hoàn tất thành công!",
            "",
            f"📌 Tiêu đề: {title or base_prefix}",
            f"📁 Thư mục lưu: {self.save_dir}",
            f"📚 Số lượng ảnh: {len(processed_files)}/{total} ảnh",
        ]
        if failed_count > 0:
            details.append(f"⚠️ Số ảnh lỗi không tải được: {failed_count}")
        if self.img_transcode and "Gốc" not in self.img_transcode:
            details.append(f"🖼️ Định dạng xuất: {self.img_transcode}")
        if self.img_res and "Gốc" not in self.img_res:
            details.append(f"📐 Chế độ phân giải: {self.img_res}")
        if self.img_compress:
            details.append(f"🗜️ Mức nén: {self.img_compress}")
        if self.img_hd_sharpness:
            details.append("✨ Tối ưu hóa nét & Màu sắc: Đã áp dụng (HD Sharpness)")
        if self.img_ai_upscale:
            details.append("🚀 AI Super-Resolution: Đã kích hoạt (x2/x4 Detail)")
        if self.img_strip_exif:
            details.append("🛡️ Siêu dữ liệu EXIF/GPS: Đã loại bỏ an toàn (Bảo toàn ICC)")

        details.append("")
        details.append("📋 Danh sách tệp đã lưu:")
        for pf in processed_files[:10]:
            details.append(f"   • {os.path.basename(pf)}")
        if len(processed_files) > 10:
            details.append(f"   ... và {len(processed_files) - 10} ảnh khác")

        if all_artifacts:
            details.append(f"📦 Tệp phụ kèm theo (Thumbs/Frames): {len(all_artifacts)} tệp")

        finish_msg = "\n".join(details)
        self._on_finish(True, finish_msg)

    def _progress_hook(self, d: dict) -> None:
        # ── Kiểm tra Cancel ──────────────────────────────────────────────
        if self.cancel_event.is_set():
            raise DownloadError("Người dùng đã hủy tải xuống.")

        # ── Kiểm tra Pause (block thread cho đến khi resume) ─────────────
        if not self.pause_event.is_set():
            self._on_status("⏸️ Tạm dừng – Nhấn ▶️ Tiếp tục để tiếp tục tải…")
            self.pause_event.wait()  # Block until resumed
            if self.cancel_event.is_set():
                raise DownloadError("Người dùng đã hủy tải xuống.")
            self._on_status("▶️ Đã tiếp tục tải…")

        status = d.get("status", "")
        if status == "downloading":
            total = d.get("total_bytes") or d.get("total_bytes_estimate") or 0
            downloaded = d.get("downloaded_bytes", 0)
            if total > 0:
                pct = downloaded / total * 100
                self._on_progress(pct)
                speed = d.get("speed")
                speed_str = f" – {speed / 1024:.0f} KB/s" if speed else ""
                self._on_status(f"Đang tải: {pct:.1f}%{speed_str}")
            else:
                self._on_status(f"Đang tải: {downloaded / 1024:.0f} KB")
        elif status == "finished":
            self._on_progress(100)
            self._on_status("Đang hoàn thiện file & xử lý hậu kỳ…")

    def _build_ydl_opts(self) -> dict:
        outtmpl = os.path.join(self.save_dir, SAFE_OUTTMPL)
        opts: dict = {
            "outtmpl": outtmpl,
            "progress_hooks": [self._progress_hook],
            "max_filesize": MAX_FILESIZE_BYTES,
            "noplaylist": True,
            "continuedl": True,   # Tiếp tục tải phần dở dang (hỗ trợ Resume)
            "part": True,         # Tải vào file .part an toàn chống truy cập file dở dang
            "quiet": True,
            "no_warnings": False,
            "socket_timeout": 30,
            "retries": 3,
            "restrictfilenames": True,
            "ignoreerrors": True,  # Không hủy toàn bộ tiến trình nếu subtitle hoặc format phụ bị rate limit
            "postprocessors": [],
        }

        # ── Cookie support ────────────────────────────────────────────────
        if self.cookie_browser:
            opts["cookiesfrombrowser"] = (self.cookie_browser,)
        elif self.cookie_file:
            cookie_path = Path(self.cookie_file)
            if cookie_path.is_file():
                opts["cookiefile"] = str(cookie_path)

        # ── Spotify là nền tảng audio đặc thù ─────────────────────────────
        effective_mode = "audio" if self.target == "spotify" else self.media_mode

        # ── Quality & Format Control: Audio vs Video ──────────────────────
        if effective_mode == "audio":
            opts["format"] = "bestaudio/best"
            pp_audio = {
                "key": "FFmpegExtractAudio",
                "preferredcodec": self.audio_codec or "mp3",
            }
            # Audio Bitrate
            m_bitrate = re.search(r"(\d{2,3})", str(self.audio_bitrate))
            if m_bitrate:
                pp_audio["preferredquality"] = m_bitrate.group(1)
            elif self.audio_bitrate and self.audio_bitrate != "auto":
                pp_audio["preferredquality"] = str(self.audio_bitrate)
            opts["postprocessors"].append(pp_audio)
        else:
            # Chế độ Video: Trích xuất độ phân giải chi tiết theo lựa chọn
            m_h = re.search(r"(\d{3,4})", str(self.video_resolution))
            h = int(m_h.group(1)) if m_h else None
            container = self.video_format if self.video_format in ("mp4", "mkv", "webm") else "mp4"

            if h:
                if container == "mp4":
                    opts["format"] = (
                        f"bestvideo[height<={h}][ext=mp4]+bestaudio[ext=m4a]/"
                        f"bestvideo[height<={h}]+bestaudio/"
                        f"best[height<={h}][ext=mp4]/best[height<={h}]/best"
                    )
                elif container == "webm":
                    opts["format"] = (
                        f"bestvideo[height<={h}][ext=webm]+bestaudio[ext=webm]/"
                        f"bestvideo[height<={h}]+bestaudio/"
                        f"best[height<={h}]/best"
                    )
                else:  # mkv
                    opts["format"] = f"bestvideo[height<={h}]+bestaudio/best[height<={h}]/best"
            else:
                # Tốt nhất / Tự động (Cao nhất)
                if container == "mp4":
                    opts["format"] = (
                        "bestvideo[ext=mp4]+bestaudio[ext=m4a]/"
                        "bestvideo[ext=mp4]+bestaudio/bestvideo+bestaudio/best[ext=mp4]/best"
                    )
                elif container == "webm":
                    opts["format"] = (
                        "bestvideo[ext=webm]+bestaudio[ext=webm]/bestvideo+bestaudio/best"
                    )
                else:  # mkv
                    opts["format"] = "bestvideo+bestaudio/best"

            opts["merge_output_format"] = container

        # ── Subtitles Control (Phụ đề & Tự động dịch) ─────────────────────
        if self.enable_subtitles:
            opts["writesubtitles"] = True
            opts["writeautomaticsub"] = True
            opts["subtitlesformat"] = "srt"

            # Tải ngôn ngữ nguồn/đích
            if self.subtitle_lang == "vi":
                opts["subtitleslangs"] = ["vi.*", "vi", "en.*", "en"]
            elif self.subtitle_lang == "en":
                opts["subtitleslangs"] = ["en.*", "en", "vi.*", "vi"]
            elif self.subtitle_lang == "both":
                opts["subtitleslangs"] = ["vi.*", "vi", "en.*", "en"]
            elif self.subtitle_lang == "all":
                opts["allsubtitles"] = True
            else:
                opts["subtitleslangs"] = ["all"]

            # Chuyển đổi sang .srt tiêu chuẩn
            opts["postprocessors"].append({"key": "FFmpegSubtitlesConvertor", "format": "srt"})

            # Nhúng phụ đề vào file video nếu người dùng chọn
            if effective_mode == "video" and self.embed_subtitles:
                opts["postprocessors"].append({"key": "FFmpegEmbedSubtitle"})

        # ── Thumbnail Control (Ảnh bìa & Nhúng bìa) ────────────────────────
        if self.enable_thumbnail or self.embed_thumbnail:
            opts["writethumbnail"] = True
            opts["postprocessors"].append({"key": "FFmpegThumbnailsConvertor", "format": "jpg"})

            if self.embed_thumbnail:
                opts["postprocessors"].append({
                    "key": "EmbedThumbnail",
                    "already_have_thumbnail": bool(self.enable_thumbnail),
                })

        # ── Video / Audio Trimming (Cắt đoạn theo thời gian) ──────────────
        s_sec = parse_time_to_seconds(self.clip_start)
        e_sec = parse_time_to_seconds(self.clip_end)
        if s_sec is not None or e_sec is not None:
            s_time = s_sec if s_sec is not None else 0.0
            e_time = e_sec if e_sec is not None else float("inf")
            if e_time > s_time:
                try:
                    from yt_dlp.utils import download_range_func
                    opts["download_ranges"] = download_range_func(None, [(s_time, e_time)])
                    opts["force_keyframes_at_cuts"] = True
                except Exception as ex:
                    log_warn(f"Không thể kích hoạt download_ranges của yt-dlp: {ex}")

        return opts

    def _handle_subtitles_postprocess(self, info: dict) -> list[str]:
        """
        Kiểm tra file phụ đề sau khi tải về. Nếu chưa có phụ đề tiếng Việt / tiếng Anh
        theo yêu cầu của người dùng, tự động phân tích và dịch từ phụ đề gốc sang .srt!
        """
        results: list[str] = []
        if not self.enable_subtitles or self.subtitle_lang not in ("vi", "en", "both"):
            return results

        extractor = (info.get("extractor") or "media").lower()
        vid = info.get("id") or ""
        prefix = f"{extractor}_{vid}"

        p_dir = Path(self.save_dir)
        # Quét các file phụ đề được yt-dlp tải về
        sub_files = list(p_dir.glob(f"{prefix}*.srt")) + list(p_dir.glob(f"{prefix}*.vtt"))

        vi_subs = [f for f in sub_files if ".vi." in f.name]
        en_subs = [f for f in sub_files if ".en." in f.name]

        # 1. Yêu cầu Tiếng Việt
        if self.subtitle_lang == "vi":
            if vi_subs:
                results.append("Đã tải phụ đề gốc Tiếng Việt (.srt)")
            elif sub_files:
                src = sub_files[0]
                target_vi = str(p_dir / f"{prefix}.vi.srt")
                self._on_status(f"🌐 Đang dịch phụ đề ({src.name}) sang Tiếng Việt…")
                ok = translate_subtitles_file(
                    str(src),
                    target_vi,
                    target_lang="vi",
                    on_progress=lambda p: self._on_status(f"🌐 Đang dịch phụ đề Tiếng Việt: {p:.0f}%"),
                )
                if ok:
                    results.append("Đã dịch tự động sang phụ đề Tiếng Việt (.vi.srt)")
            else:
                results.append("Không tìm thấy luồng phụ đề gốc trên máy chủ để dịch")

        # 2. Yêu cầu Tiếng Anh
        elif self.subtitle_lang == "en":
            if en_subs:
                results.append("Đã tải phụ đề gốc Tiếng Anh (.srt)")
            elif sub_files:
                src = sub_files[0]
                target_en = str(p_dir / f"{prefix}.en.srt")
                self._on_status(f"🌐 Đang dịch phụ đề ({src.name}) sang Tiếng Anh…")
                ok = translate_subtitles_file(
                    str(src),
                    target_en,
                    target_lang="en",
                    on_progress=lambda p: self._on_status(f"🌐 Đang dịch phụ đề Tiếng Anh: {p:.0f}%"),
                )
                if ok:
                    results.append("Đã dịch tự động sang phụ đề Tiếng Anh (.en.srt)")
            else:
                results.append("Không tìm thấy luồng phụ đề gốc trên máy chủ để dịch")

        # 3. Yêu cầu Cả Tiếng Việt & Tiếng Anh
        elif self.subtitle_lang == "both":
            # Tạo bản Tiếng Việt nếu chưa có
            if vi_subs:
                results.append("Đã có phụ đề Tiếng Việt gốc")
            elif sub_files:
                src = en_subs[0] if en_subs else sub_files[0]
                target_vi = str(p_dir / f"{prefix}.vi.srt")
                self._on_status("🌐 Đang dịch phụ đề sang Tiếng Việt…")
                if translate_subtitles_file(str(src), target_vi, target_lang="vi"):
                    results.append("Đã tạo phụ đề Tiếng Việt (.vi.srt)")

            # Tạo bản Tiếng Anh nếu chưa có
            sub_files_updated = list(p_dir.glob(f"{prefix}*.srt")) + list(p_dir.glob(f"{prefix}*.vtt"))
            en_subs_updated = [f for f in sub_files_updated if ".en." in f.name]
            vi_subs_updated = [f for f in sub_files_updated if ".vi." in f.name]

            if en_subs_updated:
                results.append("Đã có phụ đề Tiếng Anh gốc")
            elif vi_subs_updated:
                target_en = str(p_dir / f"{prefix}.en.srt")
                self._on_status("🌐 Đang dịch phụ đề sang Tiếng Anh…")
                if translate_subtitles_file(str(vi_subs_updated[0]), target_en, target_lang="en"):
                    results.append("Đã tạo phụ đề Tiếng Anh (.en.srt)")

        return results

    def _audit_local_stream(self) -> tuple[bool, str]:
        """Kiểm thử manifest Local Lab (HLS/DASH)."""
        self._on_status(STATUS_CONNECTING)
        parsed = urlparse(self.url)
        is_mpd = parsed.path.lower().endswith(".mpd")

        try:
            if HAS_REQUESTS:
                resp = requests.get(
                    self.url, timeout=15, allow_redirects=True, headers={"User-Agent": "AuditTool/1.0"}
                )
                status_code = resp.status_code
                if status_code == 401:
                    return False, f"HTTP 401 Unauthorized – Token không hợp lệ.\nURL: {self.url}"
                if status_code == 403:
                    return False, f"HTTP 403 Forbidden – Truy cập bị từ chối.\nURL: {self.url}"
                if status_code >= 400:
                    return False, f"HTTP {status_code} – Lỗi kết nối luồng."
                manifest_text = resp.text
            else:
                req = urllib.request.Request(self.url, headers={"User-Agent": "AuditTool/1.0"})
                with urllib.request.urlopen(req, timeout=15) as resp:
                    manifest_text = resp.read().decode("utf-8", errors="replace")
        except urllib.error.HTTPError as he:
            return False, f"HTTP {he.code} – {he.reason}"
        except Exception as exc:
            return False, f"Lỗi kết nối: {exc}"

        self._on_status(STATUS_AUDITING)

        # DRM Detection
        drm_list = detect_drm_mpd(manifest_text) if is_mpd else detect_drm_hls(manifest_text)
        real_drm = [d for d in drm_list if "AES-128" not in d and "ClearKey" not in d]

        if real_drm:
            drm_names = ", ".join(real_drm)
            return False, f"Phát hiện nội dung bảo vệ bởi DRM [{drm_names}].\nTừ chối xử lý."

        cleartext_warning = ""
        if check_cleartext_warning(manifest_text, is_mpd):
            self._on_status("⚠ Cảnh báo Cleartext")
            cleartext_warning = "Cảnh báo: Luồng phát ở dạng Cleartext, có nguy cơ rò rỉ dữ liệu."

        audit_parts = ["Manifest hợp lệ – cho phép tải."]
        if cleartext_warning:
            audit_parts.append(cleartext_warning)
        if drm_list:
            audit_parts.append(f"Encryption info: {', '.join(drm_list)}")

        return True, "\n".join(audit_parts)

    def run(self) -> None:
        """Entry-point chạy trong worker thread riêng."""
        try:
            if YoutubeDL is None:
                self._on_finish(False, "yt-dlp chưa được cài đặt.\nChạy: pip install yt-dlp")
                return

            ok, msg = preflight_disk_check(self.save_dir)
            if not ok:
                self._on_finish(False, msg)
                return

            # ── Kiểm tra hợp lệ dải thời gian cắt đoạn (Video / Audio Clip Trimming) ──
            if self.clip_start or self.clip_end:
                s_sec = parse_time_to_seconds(self.clip_start) if self.clip_start else 0.0
                e_sec = parse_time_to_seconds(self.clip_end) if self.clip_end else float("inf")
                if self.clip_start and parse_time_to_seconds(self.clip_start) is None:
                    self._on_status(STATUS_ERROR)
                    self._on_finish(
                        False,
                        f"Thời gian bắt đầu cắt không đúng định dạng: '{self.clip_start}'.\n"
                        "Ví dụ định dạng hợp lệ: 45 (giây), 01:30 (1 phút 30s), 00:02:15."
                    )
                    return
                if self.clip_end and parse_time_to_seconds(self.clip_end) is None:
                    self._on_status(STATUS_ERROR)
                    self._on_finish(
                        False,
                        f"Thời gian kết thúc cắt không đúng định dạng: '{self.clip_end}'.\n"
                        "Ví dụ định dạng hợp lệ: 45 (giây), 01:30 (1 phút 30s), 00:02:15."
                    )
                    return
                if s_sec is not None and e_sec is not None and s_sec >= e_sec:
                    self._on_status(STATUS_ERROR)
                    self._on_finish(
                        False,
                        f"Thời gian cắt không hợp lệ: Thời gian bắt đầu ({self.clip_start}) "
                        f"phải nhỏ hơn thời gian kết thúc ({self.clip_end})."
                    )
                    return

            audit_msg = ""
            if self.target == "locallab":
                can_go, audit_msg = self._audit_local_stream()
                if not can_go:
                    if "DRM" in audit_msg:
                        self._on_status(STATUS_DRM)
                    elif "401" in audit_msg or "403" in audit_msg:
                        self._on_status(STATUS_DENIED)
                    else:
                        self._on_status(STATUS_ERROR)
                    self._on_finish(False, audit_msg)
                    return

            # ── Xử lý đặc thù Spotify ─────────────────────────────────────
            if self.target == "spotify":
                if "/track/" not in self.url:
                    self._on_status(STATUS_ERROR)
                    self._on_finish(
                        False,
                        "Tính năng tải Spotify hỗ trợ từng bài hát cụ thể (Track).\n\n"
                        "Vui lòng dán link bài hát: https://open.spotify.com/track/ID",
                    )
                    return

                self._on_status("🎵 Đang giải mã metadata bài hát Spotify…")
                track_info = resolve_spotify_track(self.url)
                if not track_info:
                    self._on_status(STATUS_ERROR)
                    self._on_finish(False, "Không thể trích xuất thông tin bài hát từ link Spotify này.")
                    return

                track_title = track_info["title"]
                artists = track_info.get("artists", [])
                artist_str = " ".join(artists) if artists else ""
                search_query = f"ytsearch1:{artist_str} {track_title}".strip()

                self._on_status(f"🔍 Đã nhận diện: {track_title} – Đang tìm stream audio…")

                opts = self._build_ydl_opts()
                safe_spotify_filename = f"spotify_{track_info['id']}.%(ext)s"
                opts["outtmpl"] = os.path.join(self.save_dir, safe_spotify_filename)

                with YoutubeDL(opts) as ydl:
                    self._on_status(f"Đang tải audio ({self.audio_codec.upper()}): {track_title}…")
                    ydl.download([search_query])

                self._on_status(STATUS_COMPLETED)
                self._on_progress(100)

                artist_display = ", ".join(artists) if artists else "Không rõ"
                finish_msg = (
                    f"Tải bài hát Spotify hoàn tất!\n\n"
                    f"🎵 Bài hát: {track_title}\n"
                    f"🎤 Nghệ sĩ: {artist_display}\n"
                    f"🎧 Định dạng: {self.audio_codec.upper()} ({self.audio_bitrate})\n"
                    f"📁 Đã lưu: {self.save_dir}/spotify_{track_info['id']}.{self.audio_codec}\n"
                )
                self._on_finish(True, finish_msg)
                return

            # ── 1. Xử lý Facebook Photo (Ảnh bài viết fbid=...) ───────────────
            if (self.target == "facebook" or "facebook.com" in self.url.lower() or "fb.com" in self.url.lower()) and (
                any(k in self.url.lower() for k in ["/photo", "fbid=", "/photos/"])
            ):
                self._on_status("📸 Đang trích xuất ảnh Facebook Photo…")
                fb_info = resolve_facebook_photo(self.url, self.cookie_browser, self.cookie_file)
                if fb_info and (fb_info.get("media_url") or fb_info.get("images")):
                    images = fb_info.get("images") or [fb_info["media_url"]]
                    fbid = fb_info.get("id", "fb")
                    self._apply_multi_image_download_and_processing(
                        image_urls=images,
                        base_prefix=f"facebook_{fbid}",
                        title=fb_info.get("title", f"Facebook Photo #{fbid}"),
                        extra_info=fb_info,
                    )
                    return
                else:
                    self._on_status(STATUS_ERROR)
                    self._on_finish(
                        False,
                        "Không thể trích xuất link hình ảnh gốc từ Facebook Photo này.\n\n"
                        "💡 NGUYÊN NHÂN & GỢI Ý:\n"
                        "• Bài viết có thể ở chế độ Riêng tư (Private), Chỉ bạn bè, hoặc Nhóm kín (Private Group).\n"
                        "• Vui lòng mở rộng phần '🍪 Tùy chọn Cookie / Xác thực' bên dưới và chọn Cookie Browser (hoặc file cookies.txt) để xác thực và tải ảnh.",
                    )
                    return

            # ── 2. Xử lý Pinterest (Pin & Image / Video) ─────────────────────
            if self.target == "pinterest" or is_pinterest_url(self.url):
                self._on_status("📌 Đang trích xuất nội dung Pinterest chất lượng gốc…")
                pin_info = resolve_pinterest_media(self.url, self.cookie_browser, self.cookie_file)
                if pin_info and pin_info.get("media_url"):
                    media_url = pin_info["media_url"]
                    media_type = pin_info.get("media_type", "image")
                    ext = pin_info.get("ext", "jpg")
                    pin_id = pin_info.get("id", "pin")

                    if media_type == "image":
                        self._on_status(f"🖼️ Đang tải ảnh Pinterest Master #{pin_id}…")
                        dest_file = os.path.join(self.save_dir, f"pinterest_{pin_id}.{ext}")
                        ok, res_path = download_direct_file(
                            url=media_url,
                            save_path=dest_file,
                            max_bytes=MAX_FILESIZE_BYTES,
                            on_progress=self._on_progress,
                            on_status=self._on_status,
                            pause_event=self.pause_event,
                            cancel_event=self.cancel_event,
                        )
                        if not ok:
                            self._on_status(STATUS_ERROR)
                            self._on_finish(False, res_path)
                            return

                        self._apply_image_processing(
                            dest_file,
                            title=pin_info.get("title", f"Pinterest Pin #{pin_id}"),
                            extra_info=pin_info,
                        )
                        return
                    else:
                        # Video trên Pinterest: chuyển sang URL direct để tải
                        self.url = media_url

            # ── 3. Xử lý Rule34 / Booru (Image & Video) ───────────────────────
            if self.target == "rule34" or is_rule34_url(self.url):
                self._on_status("🔍 Đang trích xuất nội dung Rule34 / Booru…")
                r34_info = resolve_rule34_post(self.url)
                if r34_info and r34_info.get("media_url"):
                    media_url = r34_info["media_url"]
                    media_type = r34_info.get("media_type", "image")
                    ext = r34_info.get("ext", "jpg")
                    post_id = r34_info.get("id", "media")

                    if media_type == "image":
                        self._on_status(f"🖼️ Đang tải ảnh/GIF Rule34 #{post_id}…")
                        dest_file = os.path.join(self.save_dir, f"rule34_{post_id}.{ext}")
                        ok, res_path = download_direct_file(
                            url=media_url,
                            save_path=dest_file,
                            max_bytes=MAX_FILESIZE_BYTES,
                            on_progress=self._on_progress,
                            on_status=self._on_status,
                            pause_event=self.pause_event,
                            cancel_event=self.cancel_event,
                        )
                        if not ok:
                            self._on_status(STATUS_ERROR)
                            self._on_finish(False, res_path)
                            return

                        self._apply_image_processing(
                            dest_file,
                            title=r34_info.get("title", f"Rule34 #{post_id}"),
                            extra_info=r34_info,
                        )
                        return
                    else:
                        # Video trên booru: chuyển sang URL direct để tải
                        self.url = media_url

            # ── 4. Xử lý Telegram (Video hoặc Ảnh) ────────────────────────────
            if self.target == "telegram" or is_telegram_url(self.url):
                self._on_status("📱 Đang trích xuất media Telegram…")
                tg_info = resolve_telegram_media(self.url)
                if tg_info and tg_info.get("media_url"):
                    if tg_info.get("media_type") in ("image", "album"):
                        images = tg_info.get("images") or [tg_info["media_url"]]
                        post_id = tg_info.get("id", "tg")
                        self._apply_multi_image_download_and_processing(
                            image_urls=images,
                            base_prefix=f"telegram_{post_id}",
                            title=tg_info.get("title", f"Telegram #{post_id}"),
                            extra_info=tg_info,
                        )
                        return
                    elif tg_info.get("media_type") == "video":
                        self.url = tg_info["media_url"]

            # ── 5. Xử lý Twitter Photo / Album trực tiếp khi ở chế độ Ảnh ────
            if (self.target == "twitter" or RE_TWITTER.match(self.url)) and self.media_mode == "image":
                self._on_status("🐦 Đang trích xuất ảnh Twitter Master…")
                tw_info = extract_twitter_fallback(self.url)
                if tw_info and (tw_info.get("media_type") in ("image", "album") or tw_info.get("images")):
                    images = tw_info.get("images") or [tw_info["media_url"]]
                    self._apply_multi_image_download_and_processing(
                        image_urls=images,
                        base_prefix=f"twitter_{tw_info['id']}",
                        title=tw_info.get("title", f"Twitter Photo #{tw_info['id']}"),
                        extra_info=tw_info,
                    )
                    return

            # ── 6. Xử lý Direct Image (PNG, JPG, GIF, WebP, JNG, BMP...) ─────
            if self.target == "direct_image" or is_direct_image_url(self.url):
                self._on_status("🖼️ Đang chuẩn bị tải hình ảnh trực tiếp…")
                img_info = resolve_direct_image_info(self.url)
                download_url = (img_info.get("url") if img_info else None) or self.url
                ext = img_info.get("ext", "png") if img_info else "png"
                url_hash = hashlib.md5(download_url.encode()).hexdigest()[:10]
                clean_filename = f"image_{url_hash}.{ext}"
                dest_file = os.path.join(self.save_dir, clean_filename)

                self._on_status(f"Đang tải hình ảnh ({ext.upper()})…")
                ok, res_path = download_direct_file(
                    url=download_url,
                    save_path=dest_file,
                    max_bytes=MAX_FILESIZE_BYTES,
                    on_progress=self._on_progress,
                    on_status=self._on_status,
                    pause_event=self.pause_event,
                    cancel_event=self.cancel_event,
                )
                if not ok:
                    self._on_status(STATUS_ERROR)
                    self._on_finish(False, res_path)
                    return

                self._apply_image_processing(
                    dest_file,
                    title=img_info.get("title") if img_info else "Hình ảnh trực tiếp",
                    extra_info=img_info,
                )
                return

            # ── Tải qua yt-dlp API (YouTube, Twitter, Facebook, Iwara, ZingMP3, LocalLab, Universal...) ─
            self._on_status(STATUS_CONNECTING)
            opts = self._build_ydl_opts()

            with YoutubeDL(opts) as ydl:
                self._on_status(STATUS_AUDITING)
                info = ydl.extract_info(self.url, download=False)

                if info and info.get("_has_drm"):
                    self._on_status(STATUS_DRM)
                    self._on_finish(
                        False, "Phát hiện nội dung được bảo vệ bởi DRM (yt-dlp report). Từ chối xử lý."
                    )
                    return

                self._on_status("Đang tải dữ liệu media…")
                ydl.download([self.url])

            # Xử lý hậu kỳ phụ đề & dịch tự động
            sub_results = self._handle_subtitles_postprocess(info or {})

            self._on_status(STATUS_COMPLETED)
            self._on_progress(100)

            # Tổng hợp thông báo hoàn tất chi tiết
            details = [f"📁 Thư mục lưu: {self.save_dir}"]
            if self.media_mode == "video":
                details.append(
                    f"🎬 Định dạng: Video {self.video_format.upper()} (Độ phân giải: {self.video_resolution})"
                )
            else:
                details.append(
                    f"🎧 Định dạng: Audio {self.audio_codec.upper()} (Chất lượng: {self.audio_bitrate})"
                )

            if self.clip_start or self.clip_end:
                trim_info = f"Từ {self.clip_start or '00:00'} đến {self.clip_end or 'hết'}"
                details.append(f"✂️ Cắt đoạn (Trim): {trim_info}")

            if self.enable_subtitles:
                sub_detail_str = "; ".join(sub_results) if sub_results else self.subtitle_lang
                details.append(f"💬 Phụ đề: {sub_detail_str}")

            if self.enable_thumbnail or self.embed_thumbnail:
                t_actions = []
                if self.enable_thumbnail:
                    t_actions.append("Lưu file ảnh bìa .jpg")
                if self.embed_thumbnail:
                    t_actions.append("Nhúng ảnh bìa vào file media")
                details.append(f"🖼️ Ảnh bìa: {', '.join(t_actions)}")

            finish_msg = "Kiểm thử và tải về hoàn tất thành công!\n\n" + "\n".join(details)
            if audit_msg and "Cảnh báo" in audit_msg:
                finish_msg += f"\n\n⚠ Kết quả Audit:\n{audit_msg}"

            self._on_finish(True, finish_msg)

        except DownloadError as exc:
            err_str = clean_ansi_escape(str(exc))
            if "No video could be found" in err_str or "No media found" in err_str:
                # Thử tải Twitter qua luồng media fallback
                if self.target == "twitter" or RE_TWITTER.match(self.url):
                    fb = extract_twitter_fallback(self.url)
                    if fb:
                        if (fb.get("media_type") in ("image", "album") or fb.get("images")) and (fb.get("media_url") or fb.get("images")):
                            try:
                                images = fb.get("images") or [fb["media_url"]]
                                self._apply_multi_image_download_and_processing(
                                    image_urls=images,
                                    base_prefix=f"twitter_{fb['id']}",
                                    title=fb.get("title", f"Twitter Photo #{fb['id']}"),
                                    extra_info=fb,
                                )
                                return
                            except Exception:
                                pass
                        elif fb.get("url"):
                            try:
                                self._on_status("🔄 Đang thử tải qua luồng media Twitter dự phòng…")
                                direct_url = fb["url"]
                                opts = self._build_ydl_opts()
                                safe_tw_filename = f"twitter_{fb['id']}.%(ext)s"
                                opts["outtmpl"] = os.path.join(self.save_dir, safe_tw_filename)
                                with YoutubeDL(opts) as ydl:
                                    ydl.download([direct_url])

                                self._on_status(STATUS_COMPLETED)
                                self._on_progress(100)
                                finish_msg = (
                                    f"Kiểm thử và tải về hoàn tất thành công (qua luồng dự phòng)!\n\n"
                                    f"🎬 Tiêu đề: {fb.get('title')}\n"
                                    f"👤 Tác giả: {fb.get('uploader')}\n"
                                    f"📁 Thư mục lưu: {self.save_dir}\n"
                                )
                                self._on_finish(True, finish_msg)
                                return
                            except Exception:
                                pass

                # Thử tải Facebook qua luồng ảnh fallback nếu không có video
                if self.target == "facebook" or "facebook.com" in self.url.lower():
                    fb_photo = resolve_facebook_photo(self.url, self.cookie_browser, self.cookie_file)
                    if fb_photo and (fb_photo.get("media_url") or fb_photo.get("images")):
                        try:
                            images = fb_photo.get("images") or [fb_photo["media_url"]]
                            self._apply_multi_image_download_and_processing(
                                image_urls=images,
                                base_prefix=f"facebook_{fb_photo['id']}",
                                title=fb_photo.get("title", f"Facebook Photo #{fb_photo['id']}"),
                                extra_info=fb_photo,
                            )
                            return
                        except Exception:
                            pass

                msg = (
                    "Bài viết không chứa luồng video hợp lệ "
                    "(có thể là ảnh tĩnh hoặc bài viết bị giới hạn độ tuổi/NSFW cần đăng nhập)."
                )
                if self.target in ("twitter", "facebook") and not self.cookie_browser and not self.cookie_file:
                    msg += (
                        "\n\n💡 GỢI Ý: Nếu bài viết nhạy cảm hoặc cần đăng nhập, "
                        "hãy chọn Cookie Browser hoặc nạp cookies.txt."
                    )
                self._on_status(STATUS_ERROR)
                self._on_finish(False, f"Không tìm thấy media.\n\nChi tiết: {msg}")
            elif "login" in err_str.lower() or "log in" in err_str.lower():
                self._on_status(STATUS_DENIED)
                self._on_finish(False, f"Nền tảng yêu cầu đăng nhập.\n\nChi tiết: {err_str}")
            elif "DRM" in err_str.upper():
                self._on_status(STATUS_DRM)
                self._on_finish(False, f"Phát hiện DRM – Luồng được bảo vệ.\n\n{err_str}")
            elif re.search(r"HTTP\s*(?:Error\s*)?40[13]\b", err_str, re.IGNORECASE):
                self._on_status(STATUS_DENIED)
                self._on_finish(False, f"HTTP Access Denied.\n\nChi tiết: {err_str}")
            else:
                self._on_status(STATUS_ERROR)
                self._on_finish(False, f"Lỗi tải:\n{err_str}")

        except ExtractorError as exc:
            err_str = clean_ansi_escape(str(exc))
            if "No video could be found" in err_str or "No media found" in err_str:
                msg = (
                    "Bài viết không chứa luồng video hợp lệ "
                    "(có thể là ảnh tĩnh hoặc bài viết bị giới hạn độ tuổi/NSFW cần đăng nhập)."
                )
                self._on_status(STATUS_ERROR)
                self._on_finish(False, f"Không tìm thấy media.\n\nChi tiết: {msg}")
            else:
                self._on_status(STATUS_ERROR)
                self._on_finish(False, f"Lỗi trích xuất:\n{err_str}")

        except Exception as exc:
            err_str = clean_ansi_escape(str(exc))
            self._on_status(STATUS_ERROR)
            self._on_finish(False, f"Lỗi không xác định:\n{err_str}")


# ═══════════════════════════════════════════════════════════════════════════════
# TKINTER GUI APPLICATION
# ═══════════════════════════════════════════════════════════════════════════════

class App(tk.Tk):
    """Giao diện chính Native GUI của Media Security Downloader."""

    def __init__(self) -> None:
        super().__init__()
        self.title(f"{APP_TITLE} v{APP_VERSION}")
        self.geometry("860x920")
        self.minsize(780, 720)
        self.resizable(True, True)

        # Biến trạng thái
        self._running = False
        self._analyzing = False
        self._current_info: Optional[dict] = None
        self._photo_ref: Optional[tk.PhotoImage] = None

        # ── UX & Automation: State Variables ──────────────────────────────
        # Clipboard Monitor
        self._clipboard_monitoring = False
        self._last_clipboard: str = ""
        self._clipboard_after_id: Optional[str] = None

        # Download Queue
        self._download_queue: list[dict] = []  # [{url, target, status, title}]
        self._queue_processing = False
        self._current_queue_index: int = -1

        # Pause / Resume / Cancel
        self._pause_event = threading.Event()
        self._pause_event.set()  # Mặc định: đang chạy (not paused)
        self._cancel_event = threading.Event()
        self._pause_start_time: Optional[float] = None
        self._pause_timeout_after_id: Optional[str] = None

        # Post-download tracking
        self._last_downloaded_dir: Optional[str] = None
        self._last_downloaded_prefix: Optional[str] = None

        # Thread-safe UI dispatch queue (tương thích hoàn hảo Python 3.14+)
        self._ui_queue: queue.Queue = queue.Queue()
        self._process_ui_queue()

        style = ttk.Style(self)
        style.theme_use("clam")

        self._build_ui()

    def _process_ui_queue(self) -> None:
        """Xử lý các tác vụ UI được gửi từ worker thread lên Main loop."""
        while not self._ui_queue.empty():
            try:
                fn, args, kwargs = self._ui_queue.get_nowait()
                fn(*args, **kwargs)
            except queue.Empty:
                break
            except Exception:
                pass
        self.after(35, self._process_ui_queue)

    def ui_dispatch(self, fn: callable, *args, **kwargs) -> None:  # type: ignore[type-arg]
        """Đưa callback vào hàng đợi an toàn để thực thi trên luồng giao diện chính."""
        self._ui_queue.put((fn, args, kwargs))

    def _build_ui(self) -> None:
        # Wrapper Canvas với thanh cuộn dọc chống tràn trên mọi độ phân giải màn hình
        self.canvas = tk.Canvas(self, borderwidth=0, highlightthickness=0)
        self.scrollbar = ttk.Scrollbar(self, orient="vertical", command=self.canvas.yview)
        self.scroll_content = ttk.Frame(self.canvas)

        self.scroll_content.bind(
            "<Configure>",
            lambda e: self.canvas.configure(scrollregion=self.canvas.bbox("all")),
        )
        self.canvas_window = self.canvas.create_window(
            (0, 0), window=self.scroll_content, anchor="nw"
        )
        self.canvas.configure(yscrollcommand=self.scrollbar.set)

        self.canvas.pack(side="left", fill="both", expand=True)
        self.scrollbar.pack(side="right", fill="y")

        # Căn chỉnh chiều rộng của scroll_content theo canvas khi resize
        self.canvas.bind(
            "<Configure>",
            lambda e: self.canvas.itemconfig(self.canvas_window, width=e.width),
        )

        # Mousewheel binding
        def _on_mousewheel(event):
            if event.num == 4:
                self.canvas.yview_scroll(-1, "units")
            elif event.num == 5:
                self.canvas.yview_scroll(1, "units")
            else:
                self.canvas.yview_scroll(int(-1 * (event.delta / 120)), "units")

        self.bind_all("<Button-4>", _on_mousewheel)
        self.bind_all("<Button-5>", _on_mousewheel)
        self.bind_all("<MouseWheel>", _on_mousewheel)

        pad = {"padx": 12, "pady": 5}

        # ── 1. Header ─────────────────────────────────────────────────────
        hdr = ttk.Frame(self.scroll_content)
        hdr.pack(fill="x", **pad)
        ttk.Label(
            hdr,
            text=f"🔒 {APP_TITLE}",
            font=("Sans", 14, "bold"),
        ).pack(side="left")

        # Clipboard Monitor Toggle (mặc định: tắt vì bảo mật/quyền riêng tư)
        self.var_clipboard_monitor = tk.BooleanVar(value=False)
        self.chk_clipboard = ttk.Checkbutton(
            hdr,
            text="📋 Clipboard Monitor",
            variable=self.var_clipboard_monitor,
            command=self._toggle_clipboard_monitor,
        )
        self.chk_clipboard.pack(side="right", padx=(8, 0))

        # Tự động nạp vào hàng đợi khi copy link
        self.var_auto_queue = tk.BooleanVar(value=False)
        self.chk_auto_queue = ttk.Checkbutton(
            hdr,
            text="⚡ Auto-Queue",
            variable=self.var_auto_queue,
        )
        self.chk_auto_queue.pack(side="right", padx=(8, 0))

        ttk.Label(
            hdr,
            text=f"v{APP_VERSION} (Multi-Image & AI Core)",
            font=("Sans", 9),
            foreground="#666",
        ).pack(side="right")

        ttk.Separator(self.scroll_content, orient="horizontal").pack(fill="x", padx=12)

        # ── 2. Target & URL Frame ─────────────────────────────────────────
        frm_url = ttk.LabelFrame(self.scroll_content, text="Liên kết & Nền tảng", padding=8)
        frm_url.pack(fill="x", **pad)

        ttk.Label(frm_url, text="Mục tiêu:").grid(row=0, column=0, sticky="w", padx=(0, 6))
        self.var_target = tk.StringVar(value="YouTube")
        self.cmb_target = ttk.Combobox(
            frm_url,
            textvariable=self.var_target,
            values=[
                "YouTube",
                "Twitter / X",
                "Facebook",
                "TikTok",
                "Instagram",
                "Reddit",
                "Bilibili",
                "Pinterest (Pin & Image)",
                "Rule34 / Booru (Image & Video)",
                "Iwara (iwara.tv)",
                "Telegram (t.me)",
                "Zing MP3",
                "Spotify",
                "Hình ảnh trực tiếp (PNG/JPG/GIF...)",
                "Media trực tiếp (MP4/WebM/MP3...)",
                "Local Lab / Custom Stream (HLS/DASH)",
                "Nền tảng khác / Universal (yt-dlp)",
            ],
            state="readonly",
            width=38,
